#!/usr/bin/env python3
"""Render and apply WorkScape user hotkeys as Hyprland o.bind overlay."""
from __future__ import annotations

import argparse
import hashlib
import json
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import Any

SAFE = SourceFileLoader("workscape_hyprsafe", str(Path(__file__).resolve().parent / "hyprsafe")).load_module()
SCHEMA = SourceFileLoader("workscape_schema", str(Path(__file__).resolve().parent / "schema")).load_module()
GESTURES = SourceFileLoader("workscape_gestures", str(Path(__file__).resolve().parent / "gestures")).load_module()

OWNED_HEADER = "-- Generated by WorkScape. Do not edit."
HOTKEYS_FILE = "workscape-hotkeys.lua"


def plugin_script(plugin_dir: str) -> str:
    root = Path(plugin_dir).resolve() if plugin_dir else Path(__file__).resolve().parent.parent
    return str(root / "workscape.sh")


def collect_binds(cfg: dict[str, Any], plugin_dir: str) -> list[dict[str, str]]:
    hot = SCHEMA.normalize_hotkeys(((cfg.get("settings") or {}).get("hotkeys")))
    script = plugin_script(plugin_dir)
    if not script.startswith("/") or ".." in script or "\n" in script or '"' in script or "'" in script:
        return []
    binds: list[dict[str, str]] = []
    seen: set[str] = set()

    def add(chord: str, label: str, args: str) -> None:
        c = SCHEMA.normalize_chord(chord)
        if not c or c in seen:
            return
        allowed = {"--apply-matching", "--fresh-apply-profile"}
        allowed.update(f"--apply-workspace-here {n}" for n in range(1, 11))
        if args not in allowed:
            return
        seen.add(c)
        binds.append({
            "chord": c,
            "label": label,
            "cmd": SAFE.lua_str(f"{script} {args}"),
        })

    if hot.get("applyMatching"):
        add(hot["applyMatching"], "WorkScape: apply matching", "--apply-matching")
    if hot.get("applyFresh"):
        add(hot["applyFresh"], "WorkScape: fresh matching", "--fresh-apply-profile")
    workspaces = hot.get("workspaces") if isinstance(hot.get("workspaces"), dict) else {}
    for n in range(1, 11):
        chord = workspaces.get(str(n)) or ""
        if not chord:
            continue
        add(chord, f"WorkScape: open WS {n} here", f"--apply-workspace-here {n}")
    return binds


def render_lua(binds: list[dict[str, str]], previous: list[str] | None = None) -> str:
    chords: list[str] = []
    seen: set[str] = set()
    for c in list(previous or []) + [b["chord"] for b in binds]:
        n = SCHEMA.normalize_chord(c)
        if not n or n in seen:
            continue
        seen.add(n)
        chords.append(n)
    lines = [
        OWNED_HEADER,
        "-- User hotkeys. Empty file still unbinds chords that were removed.",
        "pcall(function()",
    ]
    for c in chords:
        lines.append(f'  hl.unbind("{SAFE.lua_str(c)}")')
    for b in binds:
        lines.append(
            f'  o.bind("{SAFE.lua_str(b["chord"])}", "{SAFE.lua_str(b["label"])}", "{b["cmd"]}")'
        )
    lines.append("end)")
    lines.append("")
    return "\n".join(lines)


def previous_chords() -> list[str]:
    doc = GESTURES.owned_get()
    raw = doc.get("hotkeyChords")
    if not isinstance(raw, list):
        return []
    out: list[str] = []
    for it in raw:
        c = SCHEMA.normalize_chord(it)
        if c and c not in out:
            out.append(c)
        if len(out) >= 16:
            break
    return out


def save_chords(chords: list[str]) -> None:
    doc = GESTURES.owned_get()
    doc["hotkeyChords"] = [SCHEMA.normalize_chord(c) for c in chords if SCHEMA.normalize_chord(c)][:16]
    GESTURES.owned_put(doc)


def eval_binds(binds: list[dict[str, str]], previous: list[str]) -> None:
    lua = render_lua(binds, previous)
    GESTURES.hypr_eval(lua)


def write_and_apply(cfg: dict[str, Any], plugin_dir: str = "", hypr_dir: str = "") -> dict[str, Any]:
    binds = collect_binds(cfg, plugin_dir)
    prev = previous_chords()
    lua = render_lua(binds, prev)
    home = Path.home()
    hypr = Path(hypr_dir) if hypr_dir else home / ".config" / "hypr"
    dest = hypr / HOTKEYS_FILE
    payload = lua.encode("utf-8")
    SAFE.write_atomic(dest, payload, mode=0o644)
    GESTURES.record_owned_bytes(HOTKEYS_FILE, payload)
    current = [b["chord"] for b in binds]
    if binds or prev:
        GESTURES.ensure_hyprland_require(hypr, GESTURES.HOTKEYS_MARK, GESTURES.HOTKEYS_LINE)
    eval_binds(binds, prev)
    save_chords(current)
    if not binds and not prev:
        try:
            data = SAFE.read_nofollow(dest, SAFE.MAX_CONFIG_BYTES)
        except OSError:
            data = b""
        owned = GESTURES.owned_get()
        digest = (owned.get("files") or {}).get(HOTKEYS_FILE)
        if digest and hashlib.sha256(data).hexdigest() == digest:
            try:
                SAFE.unlink_nofollow(dest)
            except OSError:
                pass
            files = owned.setdefault("files", {})
            files.pop(HOTKEYS_FILE, None)
            GESTURES.owned_put(owned)
            GESTURES.strip_hyprland_require(hypr, GESTURES.HOTKEYS_MARK, GESTURES.HOTKEYS_LINE)
    return {"ok": True, "path": str(dest), "binds": current}


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--config", default="")
    p.add_argument("--plugin-dir", default="")
    p.add_argument("--hypr-dir", default="")
    p.add_argument("--apply", action="store_true")
    p.add_argument("--render", action="store_true")
    args = p.parse_args()
    if not args.config:
        print("--config required", file=sys.stderr)
        return 2
    cfg = SAFE.load_json_file(Path(args.config))
    if args.render:
        print(render_lua(collect_binds(cfg, args.plugin_dir), []))
        return 0
    if not args.apply:
        print("--apply or --render required", file=sys.stderr)
        return 2
    result = write_and_apply(cfg, args.plugin_dir, args.hypr_dir)
    print(json.dumps(result))
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
