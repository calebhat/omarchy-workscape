#!/usr/bin/env python3
"""Match WorkScape profiles to currently connected Hyprland monitors.

Identities prefer EDID serial, then description (make+model+serial), and only
then the Hyprland connector name (DP-1 / DVI-I-1), which is unstable on docks.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import Any

NET = SourceFileLoader("workscape_network", str(Path(__file__).resolve().parent / "network")).load_module()
SAFE = SourceFileLoader("workscape_hyprsafe", str(Path(__file__).resolve().parent / "hyprsafe")).load_module()

_CONNECTOR_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]*$")


def safe_connector(name: str) -> str | None:
    n = str(name or "").strip()
    if _CONNECTOR_RE.fullmatch(n) and "HEADLESS" not in n:
        return n
    return None


def live_is_connected(m: dict[str, Any]) -> bool:
    if not m:
        return False
    name = str(m.get("name") or "")
    if "HEADLESS" in name:
        return False
    return True


def live_is_real(m: dict[str, Any]) -> bool:
    return live_is_connected(m)


def live_is_enabled(m: dict[str, Any]) -> bool:
    return live_is_connected(m) and not m.get("disabled")


def short_label(m: dict[str, Any]) -> str:
    desc = str(m.get("description") or "").strip()
    if desc:
        if desc.lower().startswith("hp inc. "):
            desc = desc[8:]
        return desc[:48]
    make = str(m.get("make") or "").strip()
    model = str(m.get("model") or "").strip()
    if make and model:
        return f"{make} {model}"[:48]
    return str(m.get("label") or m.get("name") or "Monitor")[:48]


def same_monitor(saved: dict[str, Any], live: dict[str, Any]) -> bool:
    ss = str(saved.get("serial") or "").strip()
    ls = str(live.get("serial") or "").strip()
    if ss and ls and ss == ls:
        return True
    sd = str(saved.get("description") or "").strip()
    ld = str(live.get("description") or "").strip()
    if sd and ld and sd == ld:
        return True
    if not ss and not sd:
        sn = str(saved.get("name") or "").strip()
        ln = str(live.get("name") or "").strip()
        return bool(sn and sn == ln)
    return False


def monitor_by_id(cfg: dict[str, Any], mid: str) -> dict[str, Any] | None:
    for m in cfg.get("monitors") or []:
        if m.get("id") == mid:
            return m
    return None


def find_live(saved: dict[str, Any], live_list: list[dict[str, Any]], enabled_only: bool = False) -> dict[str, Any] | None:
    for live in live_list:
        ok = live_is_enabled(live) if enabled_only else live_is_connected(live)
        if ok and same_monitor(saved, live):
            return live
    return None


def profile_match(cfg: dict[str, Any], profile: dict[str, Any], live_list: list[dict[str, Any]], live_net: dict[str, Any] | None = None) -> dict[str, Any]:
    live = [m for m in live_list if live_is_connected(m)]
    required = list(profile.get("monitors") or [])
    missing: list[str] = []
    extra: list[str] = []
    for mid in required:
        saved = monitor_by_id(cfg, mid)
        if not saved or not find_live(saved, live):
            missing.append(mid)
    for live_m in live:
        claimed = False
        for mid in required:
            saved = monitor_by_id(cfg, mid)
            if saved and same_monitor(saved, live_m):
                claimed = True
                break
        if not claimed:
            extra.append(short_label(live_m))
    all_present = not missing and bool(required)
    exact = all_present and not extra
    mode = "all-present" if profile.get("matchMode") == "all-present" else "exact"
    matches = all_present if mode == "all-present" else exact
    if not required:
        matches = len(live) <= 1
        exact = matches
        all_present = matches
    reason = "exact" if exact and matches else "all-present" if matches else "missing" if missing else "extra"
    net = NET.network_matches(profile.get("network"), live_net or {})
    if matches and net["constrained"] and not net["matches"]:
        matches = False
        reason = "network"
    return {
        "matches": matches,
        "exact": exact,
        "allPresent": all_present,
        "missing": missing,
        "extra": extra,
        "matchedCount": len(required) - len(missing),
        "requiredCount": len(required),
        "reason": reason,
        "networkConstrained": net["constrained"],
        "networkMatches": net["matches"],
    }


def mismatch_detail(cfg: dict[str, Any], profile: dict[str, Any], info: dict[str, Any]) -> str:
    """Human reason a profile must not apply on this hardware/network."""
    name = str(profile.get("name") or profile.get("id") or "This profile")
    if info.get("matches"):
        return ""
    reason = str(info.get("reason") or "")
    if reason == "missing":
        labels: list[str] = []
        for mid in info.get("missing") or []:
            saved = monitor_by_id(cfg, str(mid))
            labels.append(str((saved or {}).get("label") or mid))
        need = ", ".join(labels) if labels else "its saved displays"
        return f"{name} needs {need} — those displays aren't connected"
    if reason == "extra":
        extras = ", ".join(str(x) for x in (info.get("extra") or []) if x)
        if extras:
            return f"{name} is an exact layout and extra displays are connected ({extras})"
        return f"{name} is an exact layout and extra displays are connected"
    if reason == "network":
        return f"{name} is bound to a different network than this machine"
    return f"{name} does not match the current displays"


def _match_rank(profile: dict[str, Any], info: dict[str, Any]) -> tuple:
    net_boost = 2 if info.get("networkConstrained") and info.get("networkMatches") else 1
    exact_boost = 2 if info.get("exact") else 1
    claimed = int(profile.get("claimedAt") or 0)
    return (net_boost, exact_boost, int(info.get("requiredCount") or 0), claimed)


def best_profile(cfg: dict[str, Any], live_list: list[dict[str, Any]], live_net: dict[str, Any] | None = None) -> dict[str, Any] | None:
    live_net = live_net if isinstance(live_net, dict) else {}
    scored: list[tuple[tuple, dict[str, Any]]] = []
    for profile in cfg.get("profiles") or []:
        info = profile_match(cfg, profile, live_list, live_net)
        if not info["matches"]:
            continue
        scored.append((_match_rank(profile, info), profile))
    if not scored:
        return None
    scored.sort(key=lambda pair: pair[0], reverse=True)
    return scored[0][1]


def has_unconstrained_match(cfg: dict[str, Any], live_list: list[dict[str, Any]]) -> bool:
    """True if some profile matches these monitors with no network filter (a fallback)."""
    for profile in cfg.get("profiles") or []:
        info = profile_match(cfg, profile, live_list, {})
        if info["matches"] and not info.get("networkConstrained"):
            return True
    return False


def matching_profiles(cfg: dict[str, Any], live_list: list[dict[str, Any]], live_net: dict[str, Any] | None = None) -> list[dict[str, Any]]:
    live_net = live_net if isinstance(live_net, dict) else {}
    out = []
    for profile in cfg.get("profiles") or []:
        if profile_match(cfg, profile, live_list, live_net)["matches"]:
            out.append(profile)
    return out


def workspace_bindings(cfg: dict[str, Any], profile: dict[str, Any], live_list: list[dict[str, Any]]) -> dict[str, str]:
    out: dict[str, str] = {}
    mapping = profile.get("workspaceMonitors") or {}
    for ws, mid in mapping.items():
        saved = monitor_by_id(cfg, str(mid))
        if not saved:
            continue
        hit = find_live(saved, live_list, enabled_only=True)
        if hit and hit.get("name"):
            out[str(ws)] = str(hit["name"])
    return out


def _keyword_monitor(spec: str) -> None:
    SAFE.bounded_run(["hyprctl", "keyword", "monitor", spec], timeout=3.0)


def enable_monitor(m: dict[str, Any]) -> None:
    name = safe_connector(str(m.get("name") or ""))
    if not name:
        return
    w = int(m.get("width") or 0)
    h = int(m.get("height") or 0)
    refresh = float(m.get("refreshRate") or 60)
    scale = SAFE.clamp_scale(m.get("scale") or 1)
    if w <= 0 or h <= 0:
        _keyword_monitor(f"{name},preferred,auto,1")
        return
    hz = f"{refresh:.2f}".rstrip("0").rstrip(".")
    _keyword_monitor(f"{name},{w}x{h}@{hz},auto,{scale}")


def disable_monitor(m: dict[str, Any]) -> None:
    name = safe_connector(str(m.get("name") or ""))
    if name:
        _keyword_monitor(f"{name},disable")


def _hypr_eval(lua: str, timeout: float = 3) -> None:
    SAFE.bounded_run(["hyprctl", "eval", lua], timeout=timeout)


def place_monitor(m: dict[str, Any], x: int, y: int) -> None:
    name = safe_connector(str(m.get("name") or ""))
    if not name:
        return
    cur_x = int(m.get("x") or 0)
    cur_y = int(m.get("y") or 0)
    if abs(cur_x - int(x)) <= 64 and abs(cur_y - int(y)) <= 64:
        return
    w = int(m.get("width") or 0)
    h = int(m.get("height") or 0)
    refresh = float(m.get("refreshRate") or 60)
    scale = SAFE.clamp_scale(m.get("scale") or 1)
    if w <= 0 or h <= 0:
        return
    hz = f"{refresh:.2f}".rstrip("0").rstrip(".")
    pos = f"{int(x)}x{int(y)}"
    lua = (
        f'hl.monitor({{ output = "{SAFE.lua_str(name)}", mode = "{w}x{h}@{hz}", '
        f'position = "{pos}", scale = {scale} }})'
    )
    _hypr_eval(lua, timeout=3)


def disable_plan(enabled_names: list[str], disable_names: list[str]) -> list[str]:
    """Never power off the last enabled output."""
    remaining = {n for n in enabled_names if n}
    plan: list[str] = []
    for name in disable_names:
        if name not in remaining:
            continue
        if len(remaining) <= 1:
            break
        plan.append(name)
        remaining.remove(name)
    return plan


def logical_size(m: dict[str, Any]) -> tuple[int, int]:
    scale = float(m.get("scale") or 1) or 1.0
    w = int(m.get("width") or 1920)
    h = int(m.get("height") or 1080)
    return max(200, int(round(w / scale))), max(200, int(round(h / scale)))


def _rects_overlap(ax: int, ay: int, aw: int, ah: int, bx: int, by: int, bw: int, bh: int) -> bool:
    return ax < bx + bw and bx < ax + aw and ay < by + bh and by < ay + ah


def pack_monitor_positions(
    placed: list[tuple[dict[str, Any], int, int]],
) -> list[tuple[dict[str, Any], int, int]]:
    """Keep saved relative layout when it does not overlap. Else sit left-to-right.

    Sequential hl.monitor() can overlap mid-apply (KVM auto-place + saved coords)
    and Hyprland warns 'No monitors can overlap.'
    """
    items: list[dict[str, Any]] = []
    for hit, x, y in placed:
        w, h = logical_size(hit)
        items.append({"hit": hit, "x": int(x), "y": int(y), "w": w, "h": h})
    overlap = False
    for i, a in enumerate(items):
        for b in items[i + 1 :]:
            if _rects_overlap(a["x"], a["y"], a["w"], a["h"], b["x"], b["y"], b["w"], b["h"]):
                overlap = True
                break
        if overlap:
            break
    if not overlap:
        return [(it["hit"], it["x"], it["y"]) for it in items]
    items.sort(key=lambda it: (it["x"], it["y"]))
    cursor = 0
    out: list[tuple[dict[str, Any], int, int]] = []
    for it in items:
        out.append((it["hit"], cursor, 0))
        cursor += it["w"]
    return out


def place_monitors_batch(placed: list[tuple[dict[str, Any], int, int]]) -> None:
    """One eval so Hyprland sees a complete non-overlapping layout."""
    stmts: list[str] = []
    for hit, x, y in placed:
        name = safe_connector(str(hit.get("name") or ""))
        if not name:
            continue
        w = int(hit.get("width") or 0)
        h = int(hit.get("height") or 0)
        refresh = float(hit.get("refreshRate") or 60)
        scale = SAFE.clamp_scale(hit.get("scale") or 1)
        if w <= 0 or h <= 0:
            continue
        hz = f"{refresh:.2f}".rstrip("0").rstrip(".")
        pos = f"{int(x)}x{int(y)}"
        stmts.append(
            f'hl.monitor({{ output = "{SAFE.lua_str(name)}", mode = "{w}x{h}@{hz}", '
            f'position = "{pos}", scale = {scale} }})'
        )
    if stmts:
        _hypr_eval("\n".join(stmts), timeout=8)


def origin_shift_layout(placed: list[tuple[dict[str, Any], int, int]]) -> list[tuple[dict[str, Any], int, int]]:
    """Hyprland positions are absolute. Saved canvas coords may be offset; keep relative gaps."""
    if not placed:
        return []
    ox = min(x for _hit, x, _y in placed)
    oy = min(y for _hit, _x, y in placed)
    return [(hit, int(x) - ox, int(y) - oy) for hit, x, y in placed]


def save_config(cfg: dict[str, Any], path: str) -> None:
    data = (json.dumps(cfg, indent=2) + "\n").encode("utf-8")
    SAFE.write_atomic(Path(path), data, mode=0o600, max_bytes=SAFE.MAX_CONFIG_BYTES)


def apply_outputs(
    cfg: dict[str, Any],
    profile: dict[str, Any],
    live_list: list[dict[str, Any]],
    config_path: str = "",
) -> dict[str, Any]:
    mons = list(profile.get("monitors") or [])
    disabled_ids = {str(x) for x in (profile.get("disabledMonitors") or [])}
    if len(mons) < 2:
        disabled_ids = set()
    connected = [m for m in live_list if live_is_connected(m)]
    to_enable: list[dict[str, Any]] = []
    to_disable: list[dict[str, Any]] = []
    for mid in mons:
        saved = monitor_by_id(cfg, str(mid))
        if not saved:
            continue
        hit = find_live(saved, connected)
        if not hit:
            continue
        if str(mid) in disabled_ids:
            to_disable.append(hit)
        else:
            to_enable.append(hit)
    changed: list[str] = []
    for m in to_enable:
        if m.get("disabled"):
            enable_monitor(m)
            changed.append(f"on:{m.get('name')}")
    enabled_names: list[str] = []
    try:
        live_now = SAFE.hypr_json(["monitors", "all"])
        enabled_names = [str(m.get("name") or "") for m in live_now if live_is_enabled(m)]
    except Exception:
        enabled_names = [str(m.get("name") or "") for m in connected if live_is_enabled(m)]
        for m in to_enable:
            n = str(m.get("name") or "")
            if n and n not in enabled_names:
                enabled_names.append(n)
    disable_names = [str(m.get("name") or "") for m in to_disable]
    for name in disable_plan(enabled_names, disable_names):
        hit = next((m for m in to_disable if m.get("name") == name), None)
        if not hit:
            continue
        disable_monitor(hit)
        changed.append(f"off:{name}")
        if name in enabled_names:
            enabled_names.remove(name)
    layout = profile.get("monitorLayout") or {}
    if layout:
        try:
            live_now = SAFE.hypr_json(["monitors", "all"])
        except Exception:
            live_now = live_list
        placed: list[tuple[dict[str, Any], int, int]] = []
        for mid, pos in layout.items():
            if str(mid) in disabled_ids:
                continue
            saved = monitor_by_id(cfg, str(mid))
            if not saved:
                continue
            hit = find_live(saved, live_now, enabled_only=True)
            if not hit:
                continue
            x = int((pos or {}).get("x") or 0)
            y = int((pos or {}).get("y") or 0)
            placed.append((hit, x, y))
        final = pack_monitor_positions(origin_shift_layout(placed))
        needs_move = False
        for hit, x, y in final:
            if abs(int(hit.get("x") or 0) - int(x)) > 64 or abs(int(hit.get("y") or 0) - int(y)) > 64:
                needs_move = True
                break
        if not needs_move:
            return {"changed": changed}
        place_monitors_batch(final)
        for hit, x, y in final:
            changed.append(f"pos:{hit.get('name')}@{x}x{y}")
        if final:
            time.sleep(0.35)
            try:
                live_after = SAFE.hypr_json(["monitors"])
            except Exception:
                live_after = []
            persist: dict[str, dict[str, int]] = {}
            for mid in mons:
                if str(mid) in disabled_ids:
                    continue
                saved = monitor_by_id(cfg, str(mid))
                hit = find_live(saved, live_after, enabled_only=True) if saved else None
                if not hit:
                    continue
                persist[str(mid)] = {"x": int(hit.get("x") or 0), "y": int(hit.get("y") or 0)}
            if persist:
                profile["monitorLayout"] = persist
                changed.append("persisted")
                if config_path:
                    for p in cfg.get("profiles") or []:
                        if p.get("id") == profile.get("id"):
                            p["monitorLayout"] = persist
                    try:
                        save_config(cfg, config_path)
                    except Exception:
                        pass
    return {"changed": changed}


def live_status(cfg: dict[str, Any], live_list: list[dict[str, Any]], live_net: dict[str, Any] | None = None) -> dict[str, Any]:
    live = [m for m in live_list if live_is_connected(m)]
    net = live_net if isinstance(live_net, dict) else NET.detect_network()
    matched = best_profile(cfg, live, net)
    hits = matching_profiles(cfg, live, net)
    profiles = []
    for profile in cfg.get("profiles") or []:
        info = profile_match(cfg, profile, live, net)
        profiles.append({
            "id": profile.get("id"),
            "name": profile.get("name"),
            "matches": info["matches"],
            "reason": info["reason"],
            "missing": info["missing"],
            "extra": info["extra"],
            "detail": mismatch_detail(cfg, profile, info),
            "networkConstrained": info.get("networkConstrained"),
            "networkMatches": info.get("networkMatches"),
        })
    bindings = workspace_bindings(cfg, matched, live) if matched else {}
    conflicts = [p.get("id") for p in hits if matched and p.get("id") != matched.get("id")]
    return {
        "live": [
            {
                "name": m.get("name"),
                "description": m.get("description") or "",
                "serial": m.get("serial") or "",
                "make": m.get("make") or "",
                "model": m.get("model") or "",
                "label": short_label(m),
                "disabled": bool(m.get("disabled")),
                "width": m.get("width"),
                "height": m.get("height"),
                "scale": m.get("scale") or 1,
                "x": m.get("x"),
                "y": m.get("y"),
            }
            for m in live
        ],
        "matchedProfileId": (matched or {}).get("id"),
        "matchedProfileName": (matched or {}).get("name"),
        "bindings": bindings,
        "profiles": profiles,
        "network": net,
        "conflictProfileIds": conflicts,
        "conflict": bool(conflicts),
        "needsNetworkWait": not has_unconstrained_match(cfg, live),
        "networkReady": bool((net or {}).get("ssid") or (net or {}).get("subnet")),
    }


def assigned_workspaces(profile: dict[str, Any] | None) -> set[str]:
    out: set[str] = set()
    for a in (profile or {}).get("assignments") or []:
        ws = str(a.get("workspace") or "").strip()
        if ws.isdigit() and 1 <= int(ws) <= 20:
            out.add(ws)
    return out


def overflow_active_workspaces(profile: dict[str, Any] | None) -> set[str]:
    ov = (profile or {}).get("overflow") or {}
    if ov.get("enabled") is not True:
        return set()
    out: set[str] = set()
    for raw in ov.get("workspaces") or []:
        try:
            n = int(raw)
        except Exception:
            continue
        if 1 <= n <= 20:
            out.add(str(n))
    return out


def omarchy_default_workspace_lua(ws: str) -> str:
    return f'hl.workspace_rule({{ workspace = "{SAFE.lua_str(ws)}", persistent = false, layout = "dwindle" }})'


def native_layout_name(requested: str) -> str:
    if requested in ("stage", "set-width"):
        return "scrolling"
    if requested in ("dwindle", "scrolling", "master"):
        return requested
    return "dwindle"


def lock_place_count(profile: dict[str, Any], ws: str) -> int:
    n = 0
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        if str(a.get("workspace") or "") == str(ws) and a.get("lockPlace") is True:
            n += 1
    return n


def effective_ws_pref(profile: dict[str, Any], ws: str, pref: dict[str, Any] | None) -> tuple[str, int, str]:
    """Native layout + extras. Old two-lock tape profiles become dwindle + block."""
    pref = pref if isinstance(pref, dict) else {}
    layout = native_layout_name(str(pref.get("layout") or ""))
    extras = "block" if pref.get("extras") == "block" else "around"
    try:
        vis = int(pref.get("visibleCount") or 2)
    except (TypeError, ValueError):
        vis = 2
    vis = max(1, min(20, vis))
    if lock_place_count(profile, ws) >= 2 and extras != "block":
        layout = "dwindle"
        extras = "block"
    return layout, vis, extras


def reset_empty_workspaces(cfg: dict[str, Any], profile: dict[str, Any]) -> dict[str, Any]:
    """Drop leftover scroll rules on workspaces with no assigned apps.

    Overflow-chain workspaces stay scrolling while Fill next is on.
    """
    assigned = assigned_workspaces(profile)
    overflow = overflow_active_workspaces(profile)
    prefs = profile.get("workspacePrefs")
    if not isinstance(prefs, dict):
        prefs = {}
        profile["workspacePrefs"] = prefs
    cleared: list[str] = []
    kept_overflow: list[str] = []
    occupied = {s for s in os.environ.get("WORKSCAPE_OCCUPIED_WS", "").split() if s}
    for n in range(1, 21):
        ws = str(n)
        if ws in assigned:
            continue
        if ws in overflow:
            vis = int((profile.get("overflow") or {}).get("maxWindows") or 2)
            vis = max(1, min(20, vis))
            col = round(1.0 / vis, 4)
            lua = (
                f'hl.workspace_rule({{ workspace = "{SAFE.lua_str(ws)}", persistent = false, '
                f'layout = "scrolling", layout_opts = {{ column_width = {col} }} }})'
            )
            _hypr_eval(lua)
            prefs[ws] = {"layout": "scrolling", "visibleCount": vis, "lockSizes": False, "extras": "block"}
            kept_overflow.append(ws)
            continue
        if ws in occupied:
            continue
        prefs.pop(ws, None)
        prefs.pop(n, None)
        _hypr_eval(omarchy_default_workspace_lua(ws))
        cleared.append(ws)
    return {"ok": True, "cleared": cleared, "overflowKept": kept_overflow, "assigned": sorted(assigned, key=int)}


def workspace_pref_luas(ws: str, layout: str, vis: int, persist: bool = False, mon: str = "") -> list[str]:
    ws = SAFE.safe_ws(ws)
    if not ws:
        return []
    layout = native_layout_name(layout)
    vis = max(1, min(20, int(vis or 2)))
    mon = safe_connector(mon) or ""
    parts = [f'workspace = "{ws}"', f"persistent = {'true' if persist else 'false'}"]
    if mon:
        parts.append(f'monitor = "{SAFE.lua_str(mon)}"')
    parts.append(f'layout = "{layout}"')
    cmds: list[str] = []
    if layout == "scrolling":
        col = round(1.0 / vis, 4)
        parts.append(f"layout_opts = {{ column_width = {col} }}")
        cmds.append(
            f'hl.window_rule({{ name = "workscape-w{ws}-width", match = {{ workspace = "{ws}" }}, '
            f"scrolling_width = {col} }})"
        )
    elif layout == "master":
        parts.append('layout_opts = { orientation = "left" }')
        cmds.append(
            f'hl.window_rule({{ name = "workscape-w{ws}-width", match = {{ workspace = "{ws}" }}, enabled = false }})'
        )
    else:
        cmds.append(
            f'hl.window_rule({{ name = "workscape-w{ws}-width", match = {{ workspace = "{ws}" }}, enabled = false }})'
        )
    cmds.append("hl.workspace_rule({ " + ", ".join(parts) + " })")
    if mon:
        cmds.append(
            f'hl.dispatch(hl.dsp.workspace.move({{workspace="{SAFE.lua_str(ws)}", monitor="{SAFE.lua_str(mon)}"}}))'
        )
    return cmds


def stamp_workspace_pref(ws: str, layout: str, vis: int, persist: bool = False, mon: str = "") -> None:
    for lua in workspace_pref_luas(ws, layout, vis, persist, mon):
        _hypr_eval(lua)


def apply_one_ws_pref(profile: dict[str, Any], src_ws: str, dest_ws: str) -> dict[str, Any]:
    src = SAFE.safe_ws(src_ws)
    dest = SAFE.safe_ws(dest_ws)
    if not src or not dest:
        return {"ok": False, "error": "bad workspace"}
    prefs = profile.get("workspacePrefs") or {}
    pref = prefs.get(src) or prefs.get(int(src) if src.isdigit() else src) or {}
    if not isinstance(pref, dict):
        pref = {}
    layout, vis, extras = effective_ws_pref(profile, src, pref)
    _hypr_eval('pcall(function() require("hypr.workscape-binds") end)')
    stamp_workspace_pref(dest, layout, vis, False, "")
    return {
        "ok": True,
        "workspace": dest,
        "from": src,
        "layout": layout,
        "visibleCount": vis,
        "extras": extras,
    }


def apply_ws_prefs(cfg: dict[str, Any], profile: dict[str, Any], live_list: list[dict[str, Any]]) -> dict[str, Any]:
    pins = workspace_bindings(cfg, profile, live_list)
    prefs = profile.get("workspacePrefs") or {}
    overflow_ws = overflow_active_workspaces(profile)
    ws_ids = assigned_workspaces(profile) | overflow_ws
    ws_ids.discard("")
    ws_ids.discard("None")
    _hypr_eval('pcall(function() require("hypr.workscape-binds") end)')
    applied = []
    for ws in sorted(ws_ids, key=lambda s: int(s) if s.isdigit() else 99):
        ws = SAFE.safe_ws(ws)
        if not ws:
            continue
        pref = prefs.get(ws) or prefs.get(int(ws)) or {}
        if not isinstance(pref, dict):
            pref = {}
        if ws in overflow_ws and ws not in assigned_workspaces(profile):
            vis = int((profile.get("overflow") or {}).get("maxWindows") or pref.get("visibleCount") or 2)
            vis = max(1, min(20, vis))
            layout = "scrolling"
            extras = "block"
        else:
            layout, vis, extras = effective_ws_pref(profile, ws, pref)
        lock = pref.get("lockSizes") is True
        mon = pins.get(ws) or ""
        mon = safe_connector(mon) or ""
        persist = profile.get("persistentWorkspaces") is True
        stamp_workspace_pref(ws, layout, vis, persist, mon)
        applied.append({"workspace": ws, "layout": layout, "monitor": mon, "visibleCount": vis, "lockSizes": lock, "extras": extras})
    return {"ok": True, "workspaces": applied}


def main() -> int:
    parser = argparse.ArgumentParser(description="Match WorkScape profiles to live monitors")
    parser.add_argument("--config", required=True)
    parser.add_argument("--live-json", default="")
    parser.add_argument("--profile-id", default="")
    parser.add_argument("--print-id", action="store_true")
    parser.add_argument("--bindings", action="store_true")
    parser.add_argument("--status", action="store_true")
    parser.add_argument("--apply-outputs", action="store_true")
    parser.add_argument("--apply-ws-prefs", action="store_true")
    parser.add_argument("--apply-one-pref", action="store_true")
    parser.add_argument("--src", default="")
    parser.add_argument("--dest", default="")
    parser.add_argument("--reset-empty", action="store_true")
    parser.add_argument("--network-json", default="")
    parser.add_argument("--needs-identity", action="store_true")
    parser.add_argument("--require-match", action="store_true",
                        help="exit 3 unless --profile-id matches live displays/network")
    args = parser.parse_args()
    cfg = SAFE.load_json_file(Path(args.config))
    if args.live_json:
        live = SAFE.load_json_file(Path(args.live_json))
    else:
        raw = sys.stdin.buffer.read(SAFE.MAX_HYPR_JSON + 1)
        if len(raw) > SAFE.MAX_HYPR_JSON:
            print("live monitors JSON too large", file=sys.stderr)
            return 1
        live = json.loads(raw.decode("utf-8"))
    if not isinstance(live, list):
        print("live monitors JSON must be an array", file=sys.stderr)
        return 1
    live_net: dict[str, Any] | None = None
    if args.network_json:
        with open(args.network_json, encoding="utf-8") as fh:
            loaded = json.load(fh)
        live_net = loaded if isinstance(loaded, dict) else {}
    if args.needs_identity:
        print("yes" if has_unconstrained_match(cfg, live) is False else "no")
        return 0
    if args.require_match:
        pid = str(args.profile_id or "")
        prof = next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)
        if not prof:
            json.dump({"matches": False, "reason": "unknown", "detail": f"no profile {pid}"}, sys.stdout)
            sys.stdout.write("\n")
            return 3
        info = profile_match(cfg, prof, live, live_net if live_net is not None else NET.detect_network())
        out = dict(info)
        out["id"] = prof.get("id")
        out["name"] = prof.get("name")
        out["detail"] = mismatch_detail(cfg, prof, info)
        json.dump(out, sys.stdout)
        sys.stdout.write("\n")
        return 0 if info.get("matches") else 3
    if args.status:
        json.dump(live_status(cfg, live, live_net if live_net is not None else None), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if args.apply_outputs:
        pid = args.profile_id
        prof = next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)
        if not prof:
            prof = best_profile(cfg, live, live_net or {})
        if not prof:
            json.dump({"changed": []}, sys.stdout)
            sys.stdout.write("\n")
            return 2
        json.dump(apply_outputs(cfg, prof, live, config_path=str(args.config or "")), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if args.apply_ws_prefs:
        pid = args.profile_id
        prof = next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)
        if not prof:
            json.dump({"ok": False}, sys.stdout)
            sys.stdout.write("\n")
            return 2
        json.dump(apply_ws_prefs(cfg, prof, live), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if args.apply_one_pref:
        pid = args.profile_id
        prof = next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)
        if not prof:
            json.dump({"ok": False, "error": "no profile"}, sys.stdout)
            sys.stdout.write("\n")
            return 2
        result = apply_one_ws_pref(prof, args.src, args.dest)
        json.dump(result, sys.stdout)
        sys.stdout.write("\n")
        return 0 if result.get("ok") else 1
    if args.reset_empty:
        pid = args.profile_id
        prof = next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)
        if not prof:
            json.dump({"ok": False}, sys.stdout)
            sys.stdout.write("\n")
            return 2
        result = reset_empty_workspaces(cfg, prof)
        save_config(cfg, args.config)
        json.dump(result, sys.stdout)
        sys.stdout.write("\n")
        return 0
    matched = None
    if args.profile_id:
        matched = next((p for p in (cfg.get("profiles") or []) if p.get("id") == args.profile_id), None)
    else:
        matched = best_profile(cfg, live, live_net or {})
    if args.print_id:
        print((matched or {}).get("id") or "")
        return 0 if matched else 2
    if args.bindings:
        if not matched:
            json.dump({}, sys.stdout)
            sys.stdout.write("\n")
            return 2
        json.dump(workspace_bindings(cfg, matched, live), sys.stdout)
        sys.stdout.write("\n")
        return 0
    json.dump({"profile": matched, "status": live_status(cfg, live)}, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0 if matched else 2


if __name__ == "__main__":
    raise SystemExit(main())
