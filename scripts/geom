#!/usr/bin/env python3
"""Apply preview splits as Hyprland *tiled* layout, not independent floats.

Windows stay in dwindle/master so Super+mouse resize moves the shared
split. Layout pixels are backend size / scale.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import Any

SAFE = SourceFileLoader("workscape_hyprsafe", str(Path(__file__).resolve().parent / "hyprsafe")).load_module()


_json_cache: dict[str, Any] = {}
_layout_ready = False


def hypr_j(cmd: str, cached: bool = False) -> Any:
    if cached and cmd in _json_cache:
        return _json_cache[cmd]
    raw = SAFE.bounded_output(["hyprctl", "-j", cmd], timeout=3.0, max_bytes=SAFE.MAX_HYPR_JSON)
    data = json.loads(raw.decode("utf-8"))
    if cached:
        _json_cache[cmd] = data
    return data


def cache_clear() -> None:
    _json_cache.clear()


def hypr_eval(lua: str) -> None:
    SAFE.bounded_run(["hyprctl", "eval", lua], timeout=2.0)


def _css_box(option: str, fallback: int) -> tuple[int, int, int, int]:
    try:
        raw = hypr_j(f"getoption {option}", cached=True)
        css = str(raw.get("css") or fallback)
        parts = [int(float(p)) for p in css.replace("px", "").split()]
        if len(parts) == 1:
            return parts[0], parts[0], parts[0], parts[0]
        if len(parts) == 4:
            return parts[0], parts[1], parts[2], parts[3]
    except Exception:
        pass
    return fallback, fallback, fallback, fallback


def gaps_out() -> tuple[int, int, int, int]:
    """Return top, right, bottom, left gaps_out."""
    return _css_box("general:gaps_out", 8)


def gaps_in() -> tuple[int, int, int, int]:
    """Return top, right, bottom, left gaps_in."""
    return _css_box("general:gaps_in", 4)


def border_size() -> int:
    try:
        raw = hypr_j("getoption general:border_size", cached=True)
        return max(0, int(raw.get("int") or 0))
    except Exception:
        return 2


def layout_metrics(mon: dict[str, Any]) -> dict[str, float]:
    scale = float(mon.get("scale") or 1) or 1.0
    lw = float(mon.get("width") or 0) / scale
    lh = float(mon.get("height") or 0) / scale
    reserved = list(mon.get("reserved") or [0, 0, 0, 0]) + [0, 0, 0, 0]
    rl, rt, rr, rb = (float(reserved[0]), float(reserved[1]), float(reserved[2]), float(reserved[3]))
    gt, gr, gb, gl = gaps_out()
    x = float(mon.get("x") or 0) + rl + gl
    y = float(mon.get("y") or 0) + rt + gt
    w = max(80.0, lw - rl - rr - gl - gr)
    h = max(60.0, lh - rt - rb - gt - gb)
    return {"x": x, "y": y, "w": w, "h": h, "scale": scale, "lw": lw, "lh": lh}


def _same_mon_id(a: Any, b: Any) -> bool:
    if a is None or b is None:
        return False
    if a == b:
        return True
    try:
        return int(a) == int(b)
    except (TypeError, ValueError):
        return str(a) == str(b)


def monitor_for_client(c: dict[str, Any], monitors: list[dict[str, Any]]) -> dict[str, Any] | None:
    """Hyprland clients expose `monitor` as an integer id, not a connector name."""
    if not monitors:
        return None
    mid = c.get("monitor")
    for m in monitors:
        if _same_mon_id(m.get("id"), mid):
            return m
    name = c.get("monitorName") or (mid if isinstance(mid, str) else None)
    if name:
        for m in monitors:
            if m.get("name") == name:
                return m
    return None


def monitor_for_workspace(ws: str, monitors: list[dict[str, Any]], workspaces: list[dict[str, Any]]) -> dict[str, Any] | None:
    name = None
    for w in workspaces:
        if str(w.get("id")) == str(ws) or str(w.get("name")) == str(ws):
            name = w.get("monitor")
            break
    if not name:
        for m in monitors:
            if m.get("focused"):
                return m
        return monitors[0] if monitors else None
    return next((m for m in monitors if m.get("name") == name), None)


def geom_pixels(geom: dict[str, Any], metrics: dict[str, float]) -> dict[str, int]:
    x = metrics["x"] + float(geom.get("x") or 0) * metrics["w"]
    y = metrics["y"] + float(geom.get("y") or 0) * metrics["h"]
    w = max(80.0, float(geom.get("w") or 1) * metrics["w"])
    h = max(60.0, float(geom.get("h") or 1) * metrics["h"])
    max_x = float(metrics["x"]) + float(metrics["w"])
    max_y = float(metrics["y"]) + float(metrics["h"])
    if x + w > max_x:
        w = max(80.0, max_x - x)
    if y + h > max_y:
        h = max(60.0, max_y - y)
    x = max(float(metrics["x"]), x)
    y = max(float(metrics["y"]), y)
    return {"x": int(round(x)), "y": int(round(y)), "w": int(round(w)), "h": int(round(h))}


def groupbar_px() -> int:
    """Vertical space a groupbar steals from a grouped window's tile.

    A grouped window's box starts below its groupbar, so its height is short by
    this much compared with the tile the whole group occupies. Measured as
    height + gaps_in + indicator_height, which matches Hyprland (22 + 5 + 1 = 28
    with the stock Omarchy groupbar).
    """
    try:
        if not (hypr_j("getoption group:groupbar:enabled", cached=True) or {}).get("bool"):
            return 0
    except Exception:
        return 0

    def _int(name: str, default: int) -> int:
        try:
            return int((hypr_j(f"getoption {name}", cached=True) or {}).get("int", default))
        except Exception:
            return default

    return max(0, _int("group:groupbar:height", 22)
               + _int("group:groupbar:gaps_in", 5)
               + _int("group:groupbar:indicator_height", 1))


def tile_px(addr: str, geom: dict[str, Any], metrics: dict[str, float]) -> dict[str, int]:
    """Pixels to stamp on `addr` so the tile it occupies matches `geom`.

    For a grouped window the box we can set is the one below the groupbar, so
    asking for the full tile would push the group past its neighbours by the
    groupbar height on every apply.
    """
    px = geom_pixels(geom, metrics)
    bar = 0
    if len(_group_member_addrs(str(addr), cached=True)) >= 2:
        bar = groupbar_px()
    if bar and int(px.get("h") or 0) > bar * 2:
        px = dict(px, y=int(px["y"]) + bar, h=int(px["h"]) - bar)
    return px


def box_to_geom(box: dict[str, int], metrics: dict[str, float], min_size: float = 0.04) -> dict[str, float]:
    mw = float(metrics.get("w") or 1) or 1.0
    mh = float(metrics.get("h") or 1) or 1.0
    floor = max(0.01, float(min_size))
    x = (float(box.get("x") or 0) - float(metrics.get("x") or 0)) / mw
    y = (float(box.get("y") or 0) - float(metrics.get("y") or 0)) / mh
    w = float(box.get("w") or 0) / mw
    h = float(box.get("h") or 0) / mh
    return {
        "x": max(0.0, min(1.0, round(x, 4))),
        "y": max(0.0, min(1.0, round(y, 4))),
        "w": max(floor, min(1.0, round(w, 4))),
        "h": max(floor, min(1.0, round(h, 4))),
    }


def assignment_is_locked(assignment: dict[str, Any], prefs: dict[str, Any] | None) -> bool:
    if assignment.get("lockPlace") is True:
        return True
    ws = str(assignment.get("workspace") or "")
    pref = (prefs or {}).get(ws) or {}
    return pref.get("lockSizes") is True


def occupied_skip(ws: str, profile: dict[str, Any] | None = None) -> bool:
    """Skip unassigned occupied workspaces. Locked splits still restamp."""
    occupied = {s for s in os.environ.get("WORKSCAPE_OCCUPIED_WS", "").split() if s}
    if str(ws) not in occupied:
        return False
    if os.environ.get("WORKSCAPE_MIGRATE_OCCUPIED") == "1":
        return False
    n_lock = 0
    for a in (profile or {}).get("assignments") or []:
        if a.get("enabled") is False:
            continue
        if str(a.get("workspace") or "") != str(ws):
            continue
        if a.get("lockPlace") is True:
            n_lock += 1
    if n_lock >= 2:
        return False
    pref = ((profile or {}).get("workspacePrefs") or {}).get(str(ws)) or {}
    if not isinstance(pref, dict):
        pref = {}
    if pref.get("lockSizes") is True and n_lock >= 1:
        return False
    return True


def lock_plan_for_workspace(profile: dict[str, Any], ws: str) -> dict[str, Any]:
    """Apply-time geoms for assigned windows. Does not drive a live tape."""
    prefs = profile.get("workspacePrefs") or {}
    pref = prefs.get(str(ws)) or {}
    vis = clamp_visible_count(pref.get("visibleCount") or 2)
    extras = "block" if pref.get("extras") == "block" else "around"
    layout = str(pref.get("layout") or "dwindle")
    if layout in ("stage", "set-width"):
        layout = "scrolling"
    if layout not in ("dwindle", "scrolling", "master"):
        layout = "dwindle"
    n_lock = 0
    locked = []
    seen_groups: set[str] = set()
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        if str(a.get("workspace") or "") != str(ws):
            continue
        # A Hyprland group is a single tile. Only its first enabled member
        # stands in for it here, or the split would be laid out for one pane
        # per window and the group would be squeezed into a fraction of it.
        token = str(a.get("group") or "")
        if token:
            if token in seen_groups:
                continue
            seen_groups.add(token)
        if a.get("lockPlace") is True or a.get("geom"):
            locked.append(a)
        if a.get("lockPlace") is True:
            n_lock += 1
    if n_lock >= 2 and extras != "block":
        layout = "dwindle"
        extras = "block"
    return {
        "workspace": str(ws),
        "locked": locked,
        "lock_all": pref.get("lockSizes") is True,
        "extras": extras,
        "visibleCount": vis,
        "prefs": prefs,
        "layout": layout,
        "stage": False,
        "setWidth": False,
    }


def load_config(path: str) -> dict[str, Any]:
    return SAFE.load_json_file(Path(path))


def active_profile(cfg: dict[str, Any], profile_id: str = "") -> dict[str, Any] | None:
    profiles = cfg.get("profiles") or []
    pid = profile_id or ((cfg.get("settings") or {}).get("activeProfileId")) or ""
    if pid:
        hit = next((p for p in profiles if p.get("id") == pid), None)
        if hit:
            return hit
    return profiles[0] if profiles else None


def config_path() -> str:
    override = os.environ.get("WORKSCAPE_CONFIG", "").strip()
    if override:
        return override
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return str(Path(state) / "omarchy/workscape/config.json")


def apply_chrome(addr: str, chrome: dict[str, Any] | None, focused: bool) -> None:
    addr = SAFE.safe_addr(addr)
    if not addr or not isinstance(chrome, dict):
        return
    a = f"address:{addr}"
    op = chrome.get("opacityActive") if focused else chrome.get("opacityInactive")
    try:
        alpha = float(op)
    except Exception:
        alpha = 1.0
    if alpha < 0.2:
        alpha = 0.2
    if alpha > 1:
        alpha = 1.0
    hypr_eval(f'hl.dispatch(hl.dsp.window.set_prop({{ window="{a}", prop="alpha", value="{alpha:.2f}" }}))')
    bs = chrome.get("borderSize")
    if isinstance(bs, int) and bs >= 0:
        hypr_eval(f'hl.dispatch(hl.dsp.window.set_prop({{ window="{a}", prop="bordersize", value="{int(bs)}" }}))')
    show = chrome.get("borderActive") if focused else chrome.get("borderInactive")
    color = chrome.get("borderColorActive") if focused else chrome.get("borderColorInactive")
    if show is False:
        hypr_eval(f'hl.dispatch(hl.dsp.window.set_prop({{ window="{a}", prop="bordersize", value="0" }}))')
    elif color:
        col = str(color).replace("#", "")
        if len(col) in (6, 8):
            hypr_eval(f'hl.dispatch(hl.dsp.window.set_prop({{ window="{a}", prop="bordercolor", value="rgb({col[:6]})" }}))')


def _float_window(addr: str, want_float: bool) -> None:
    """Force float on/off. Never toggle — toggle on a full-size pane sticks (I-031)."""
    addr = SAFE.safe_addr(addr)
    if not addr:
        return
    a = f"address:{addr}"
    action = "on" if want_float else "off"
    hypr_eval(f'hl.dispatch(hl.dsp.window.float({{ action = "{action}", window = "{a}" }}))')
    cache_clear()


def ensure_floating(addr: str, want: bool) -> None:
    addr = SAFE.safe_addr(addr)
    if not addr:
        return
    c = client_by_addr(addr)
    if not c:
        return
    is_f = c.get("floating") is True
    if bool(is_f) != bool(want):
        _float_window(addr, want)


def raise_window(addr: str) -> None:
    """Keep a floating window above tiled ones without stealing focus."""
    addr = SAFE.safe_addr(addr)
    if not addr:
        return
    a = f"address:{addr}"
    hypr_eval(f'hl.dispatch(hl.dsp.window.alter_zorder({{ window = "{a}", mode = "top" }}))')
    hypr_eval(f'hl.dispatch(hl.dsp.window.bring_to_top({{ window = "{a}" }}))')


def apply_abs_box(addr: str, px: dict[str, Any]) -> dict[str, int] | None:
    addr = SAFE.safe_addr(addr)
    if not addr:
        return None
    ensure_floating(addr, True)
    cache_clear()
    box = actual_box(addr)
    if not box:
        return None
    want_w = int(px.get("w") or 0)
    want_h = int(px.get("h") or 0)
    want_x = int(px.get("x") or 0)
    want_y = int(px.get("y") or 0)
    dx = want_w - int(box.get("w") or 0)
    dy = want_h - int(box.get("h") or 0)
    if abs(dx) >= 4 or abs(dy) >= 4:
        resize_relative(addr, dx, dy)
        cache_clear()
        box = actual_box(addr) or box
    mx = want_x - int(box.get("x") or 0)
    my = want_y - int(box.get("y") or 0)
    if abs(mx) >= 2 or abs(my) >= 2:
        hypr_eval(
            f'hl.dispatch(hl.dsp.window.move({{ window = "address:{addr}", x = {int(mx)}, y = {int(my)}, relative = true }}))'
        )
        cache_clear()
    return actual_box(addr)


def force_tiled(addr: str) -> None:
    """Tile by address. Full-size floats ignore Super+T; shrink once, then off again (I-031)."""
    addr = SAFE.safe_addr(addr)
    if not addr:
        return
    _float_window(addr, False)
    c = client_by_addr(addr)
    if not c or c.get("floating") is not True:
        return
    box = actual_box(addr)
    if box and int(box.get("w") or 0) >= 80 and int(box.get("h") or 0) >= 80:
        resize_relative(addr, -64, -64)
        cache_clear()
    _float_window(addr, False)


def swap_windows(a_addr: str, b_addr: str) -> None:
    a_addr = SAFE.safe_addr(a_addr)
    b_addr = SAFE.safe_addr(b_addr)
    if not a_addr or not b_addr:
        return
    hypr_eval(
        f'hl.dispatch(hl.dsp.window.swap({{ window = "address:{a_addr}", with = "address:{b_addr}" }}))'
    )


def resize_relative(addr: str, dx: int, dy: int) -> None:
    addr = SAFE.safe_addr(addr)
    if not addr:
        return
    a = f"address:{addr}"
    hypr_eval(f'hl.dispatch(hl.dsp.window.resize({{window="{a}", x={int(dx)}, y={int(dy)}, relative=true}}))')


def clear_size_lock(addr: str) -> None:
    """No-op. set_prop min_size/max_size SIGABRT'd Hyprland (I-031 / 20:51 crash)."""
    return


def set_size_lock(addr: str, w: int, h: int) -> None:
    """No-op. Tiled min_size blocked Super+T and kept panes floating (I-021/I-024)."""
    return


def clear_all_size_locks(addrs: list[str] | None = None) -> int:
    """Clear min_size/max_size on given addresses, or every mapped client."""
    n = 0
    if addrs is None:
        try:
            clients = hypr_j("clients")
        except Exception:
            return 0
        addrs = [str(c.get("address") or "") for c in (clients or [])]
    for addr in addrs:
        if SAFE.safe_addr(addr):
            clear_size_lock(addr)
            n += 1
    return n


def exec_silent_lua(cmd: str, ws: str, monitor: str = "") -> str:
    """Lua for spawn that must not steal focus. Tests assert this string."""
    ws = SAFE.safe_ws(ws) or ""
    cmd_s = SAFE.lua_str(cmd)
    parts = [f'workspace = "{ws} silent"', "no_initial_focus = true", "tile = true"]
    mon = SAFE.safe_connector(monitor) if monitor else None
    if mon:
        parts.append(f'monitor = "{mon} silent"')
    return f'hl.dispatch(hl.dsp.exec_cmd("{cmd_s}", {{ {", ".join(parts)} }}))'


def exec_silent(cmd: str, ws: str, monitor: str = "") -> str:
    """Spawn onto `ws` without focusing it. Returns the eval string sent."""
    lua = exec_silent_lua(cmd, ws, monitor)
    if SAFE.safe_ws(ws) and str(cmd or "").strip():
        hypr_eval(lua)
    return lua


def pin_workspace_silent(ws: str, monitor: str, layout: str = "") -> None:
    """Bind a workspace to a monitor without focusing either.

    Always send layout when we know it. A monitor-only rule replaces the
    previous rule and Hyprland falls back to scrolling, which equal-splits
    locked panes.
    """
    ws = SAFE.safe_ws(ws)
    mon = SAFE.safe_connector(monitor)
    if not ws or not mon:
        return
    layout = layout if layout in ("dwindle", "scrolling", "master") else ""
    extra = f', layout = "{layout}"' if layout else ""
    hypr_eval(
        f'hl.workspace_rule({{ workspace = "{ws}", monitor = "{mon}", persistent = false{extra} }})'
    )
    hypr_eval(
        f'hl.dispatch(hl.dsp.workspace.move({{ workspace = "{ws}", monitor = "{mon}" }}))'
    )


def clamp_visible_count(visible_count: int | str | None) -> int:
    try:
        vis = 2 if visible_count is None or visible_count == "" else int(visible_count)
    except Exception:
        vis = 2
    return min(20, max(1, vis))


def extra_column_frac(visible_count: int) -> float:
    vis = clamp_visible_count(visible_count)
    return round(1.0 / vis, 4)


# Strip of a neighbor column (~38px on 1920, ~29px on 1440 logical).
# Set-width and lock splits stay exact 1/N. Extras stay 1/Visible.
PEEK_FRAC = 0.02


def peeked_column_frac(visible_count: int) -> float:
    """Extra/scroll width so vis columns plus left and right peeks fit.

    vis=2 and PEEK 0.02 → 0.48. Exact 1/N left no room for a left peek
    without cutting off the right column.
    """
    vis = clamp_visible_count(visible_count)
    exact = extra_column_frac(vis)
    peeked = round((1.0 - 2 * PEEK_FRAC) / vis, 4)
    if peeked < 0.1:
        return exact
    return min(exact, peeked)


def stage_fill_frac() -> float:
    """Lone Stage pane: almost full, with a peek of the next extra."""
    return round(1.0 - PEEK_FRAC, 4)


def column_width_frac(it: dict[str, Any], extra_frac: float) -> float:
    """Locked / assigned geoms keep their width; extras use Visible 1/N."""
    g = it.get("geom") or {}
    w = float(g.get("w") or 0)
    if it.get("lock") is True or w >= 0.1:
        if w >= 0.1:
            return max(0.1, min(1.0, round(w, 4)))
    return max(0.05, min(1.0, float(extra_frac)))


def fit_column_fracs(fracs: list[float], metrics: dict[str, float], n_cols: int) -> list[float]:
    """Map custom column ratios onto the usable layout width.

    colresize is a fraction of the *monitor* width. Assigned panes should
    still fill the usable area (native outer gaps only). Visible-count is
    for extra columns, not for shrinking a custom split.
    """
    if not fracs or n_cols < 1:
        return fracs
    lw = float(metrics.get("lw") or metrics.get("w") or 1) or 1.0
    usable = float(metrics.get("w") or lw) or lw
    _it, ir, _ib, il = gaps_in()
    between = max(0, n_cols - 1) * (il + ir)
    inner = max(80.0, usable - between)
    total = sum(max(0.05, f) for f in fracs) or 1.0
    return [max(0.08, min(0.98, round((f / total) * inner / lw, 4))) for f in fracs]


def clamp_scrolling_to_monitor(ws: str, metrics: dict[str, float], items: list[dict[str, Any]]) -> None:
    """Remove extra side padding. Hyprland centers a short scrolling tape.

    A lone column is colresize 1.0. Several columns: fit expand the last one
    into leftover space. Do not pan a small gutter (that looked off-center
    until the workspace was focused).
    """
    lw = float(metrics.get("lw") or metrics.get("w") or 0)
    if lw < 80:
        return
    left = int(round(float(metrics.get("x") or 0)))
    right_edge = int(round(left + float(metrics.get("w") or lw)))
    cache_clear()
    tiled = [c for c in sort_clients_axis(clients_on_workspace(ws), "x") if not c.get("floating")]
    if not tiled:
        return
    first = tiled[0]
    last = tiled[-1]
    first_addr = first.get("address")
    last_addr = last.get("address")
    first_x = int(((first.get("at") or [0, 0]) + [0, 0])[0])
    last_at = last.get("at") or [0, 0]
    last_sz = last.get("size") or [0, 0]
    last_end = int(last_at[0]) + int(last_sz[0])
    left_slack = first_x - left
    right_slack = right_edge - last_end
    # Fresh apply can pan the tape to the last-launched pane (Control). A
    # 67/33 split then sits ~300px right with the last column cut off.
    # 16px (user desk WS2 after Fresh) is enough to look "both panes shifted".
    if abs(left_slack) > 8 and first_addr:
        focus_window(str(first_addr))
        if not layout_msg_on(str(ws), f"move {-left_slack}"):
            layout_msg(f"move {-left_slack}")
        time.sleep(0.03)
        cache_clear()
        tiled = [c for c in sort_clients_axis(clients_on_workspace(ws), "x") if not c.get("floating")]
        if not tiled:
            return
        last = tiled[-1]
        last_addr = last.get("address")
        last_at = last.get("at") or [0, 0]
        last_sz = last.get("size") or [0, 0]
        last_end = int(last_at[0]) + int(last_sz[0])
        first_x = int(((tiled[0].get("at") or [0, 0]) + [0, 0])[0])
        left_slack = first_x - left
        right_slack = right_edge - last_end
    peek_px = max(24, int(round(PEEK_FRAC * lw)))
    if len(tiled) == 1:
        if (left_slack > 8 or right_slack > peek_px + 8) and first_addr:
            focus_window(str(tiled[0].get("address") or first_addr))
            layout_msg(f"colresize {stage_fill_frac()}")
            time.sleep(0.02)
        return
    if right_slack > peek_px * 2 + 8 and last_addr:
        focus_window(str(last_addr))
        layout_msg("fit expand")
        time.sleep(0.02)


def pack_peek_camera(ws: str, addr: str = "") -> None:
    """Removed. Hyprland scrolling owns the camera."""
    return
    _ = (ws, addr)
    """Pan so peek strips show only where you can still scroll.

    Leftmost: flush left, small right peek. Middle: peek both sides.
    Rightmost: flush right, small left peek. Does not colresize.
    """
    ws = str(ws)
    try:
        aw = hypr_j("activeworkspace")
        if str((aw or {}).get("id") or "") != ws:
            return
    except Exception:
        return
    cache_clear()
    tiled = [c for c in sort_clients_axis(clients_on_workspace(ws), "x") if not c.get("floating")]
    if not tiled:
        return
    hit = None
    idx = 0
    want = str(addr or "")
    if want:
        for i, c in enumerate(tiled):
            if str(c.get("address") or "") == want:
                hit, idx = c, i
                break
    if hit is None:
        hit, idx = tiled[0], 0
    if hit.get("floating"):
        return
    monitors = hypr_j("monitors", cached=True)
    workspaces = hypr_j("workspaces", cached=True)
    mon = monitor_for_workspace(ws, monitors, workspaces)
    if not mon:
        return
    scale = float(mon.get("scale") or 1) or 1
    lw = float(mon.get("width") or 0) / scale
    if lw < 80:
        return
    mx = int(mon.get("x") or 0)
    peek_px = max(16, int(round(PEEK_FRAC * lw)))
    at = hit.get("at") or [0, 0]
    size = hit.get("size") or [0, 0]
    x = int(at[0] or 0)
    w = int(size[0] or 0)
    if w < 40:
        return
    n = len(tiled)
    has_left = idx > 0
    has_right = idx < n - 1
    mon_right = mx + int(round(lw))
    # Last column hanging off this monitor: pull it back first so extras
    # are not painted on the next output (looks like the wrong workspace).
    over = (x + w) - mon_right
    if over > 8:
        layout_msg(f"move {-over}")
        return
    if has_left and has_right:
        target_x = mx + peek_px
    elif has_left:
        target_x = mon_right - w
    else:
        target_x = mx
    slack = x - int(target_x)
    if abs(slack) <= 8:
        return
    new_x = x - slack
    new_right = new_x + w
    # Keep the focused column on this monitor. A pan that would park it
    # on the next output is the I-050 yank; clamp to flush-right instead.
    if new_right > mon_right + 8:
        slack = x - (mon_right - w)
        new_x = x - slack
        new_right = new_x + w
    if abs(slack) <= 8:
        return
    if new_right > mon_right + 8:
        return
    if new_x + w < mx + 8:
        return
    layout_msg(f"move {-slack}")


def scrolling_layout_opts(visible_count: int, lock: bool = False, stage: bool = False, fill_one: bool = False) -> str:
    col = max(0.1, extra_column_frac(visible_count))
    _ = (lock, stage, fill_one)
    return f"column_width = {col}"


OMARCHY_SCROLLING_COLUMN_WIDTH = 0.49


def apply_scrolling_globals() -> None:
    """No-op. Leave Omarchy/Hyprland scrolling defaults alone."""
    return


def sync_column_width_for_workspace(ws: str, visible_count: int | None = None) -> None:
    """Match Hyprland’s spawn default to this workspace’s Visible 1/N."""
    layout = ""
    if visible_count is None:
        try:
            cfg = load_config(config_path())
            profile = active_profile(cfg)
            pref = ((profile or {}).get("workspacePrefs") or {}).get(str(ws)) or {}
            layout = str(pref.get("layout") or "")
            if layout in ("scrolling", "stage", "set-width"):
                visible_count = clamp_visible_count(pref.get("visibleCount") or 2)
        except Exception:
            visible_count = None
    if not visible_count:
        apply_spawn_width_rule(ws, None)
        if layout in ("", "dwindle") and SAFE.safe_ws(ws):
            force_dwindle(ws)
        return
    extra = extra_column_frac(int(visible_count))
    if layout in ("scrolling", "stage"):
        extra = peeked_column_frac(int(visible_count))
    apply_spawn_width_rule(ws, extra)
    # Workspace scrolling_width is enough. Global column_width restamps
    # unassigned scrolling sessions (WS5 Grok CLI) to 1/N.
    repair_unmanaged_workspaces()


def apply_spawn_width_rule(ws: str, frac: float | None) -> None:
    """Hyprland scrolling_width: spawn width for windows on this workspace."""
    ws = SAFE.safe_ws(ws)
    if not ws:
        return
    name = f"workscape-w{ws}-width"
    if frac is None:
        hypr_eval(
            f'hl.window_rule({{ name = "{name}", match = {{ workspace = "{ws}" }}, enabled = false }})'
        )
        return
    try:
        f = float(frac)
    except (TypeError, ValueError):
        f = OMARCHY_SCROLLING_COLUMN_WIDTH
    f = max(0.1, min(1.0, round(f, 4)))
    hypr_eval(
        f'hl.window_rule({{ name = "{name}", match = {{ workspace = "{ws}" }}, scrolling_width = {f} }})'
    )


def set_global_column_width(frac: float, fill_one: bool | None = None) -> None:
    """New scrolling columns use the global default. workspace_rule layout_opts
    are ignored for spawn, so this must match Visible 1/N."""
    try:
        f = float(frac)
    except (TypeError, ValueError):
        f = OMARCHY_SCROLLING_COLUMN_WIDTH
    f = max(0.1, min(1.0, f))
    if fill_one is None:
        hypr_eval(
            f"hl.config({{ scrolling = {{ column_width = {round(f, 4)}, follow_focus = false, "
            f"follow_min_visible = 1.0, focus_fit_method = 1 }} }})"
        )
        return
    fs = "true" if fill_one else "false"
    hypr_eval(
        f"hl.config({{ scrolling = {{ column_width = {round(f, 4)}, fullscreen_on_one_column = {fs}, "
        f"follow_focus = false, follow_min_visible = 1.0, focus_fit_method = 1 }} }})"
    )


def restamp_scrolling_default(
    ws: str,
    visible_count: int,
    lock: bool = False,
    stage: bool = False,
    n_cols: int = 1,
    set_width: bool = False,
) -> None:
    """Set scrolling layout + spawn width. Do not colresize live columns."""
    _ = (lock, stage, n_cols, set_width)
    vis = clamp_visible_count(visible_count)
    extra = extra_column_frac(vis)
    if not workspace_is_scrolling(ws):
        force_scrolling(ws, vis)
    apply_spawn_width_rule(ws, extra)


def _tiled_addr_order(ws: str) -> list[str]:
    cache_clear()
    tiled = [c for c in clients_on_workspace(ws) if not c.get("floating")]
    tiled = sorted(tiled, key=lambda c: int(((c.get("at") or [0, 0]) + [0, 0])[0]))
    out = []
    for c in tiled:
        a = SAFE.safe_addr(str(c.get("address") or ""))
        if a:
            out.append(a)
    return out


def extra_is_after_locked(addr: str, ws: str, locked_addrs: set[str]) -> bool:
    addr = SAFE.safe_addr(addr) or ""
    locked = {SAFE.safe_addr(a) or "" for a in locked_addrs}
    locked.discard("")
    addrs = _tiled_addr_order(ws)
    if not addr or addr not in addrs:
        return False
    lock_is = [addrs.index(a) for a in locked if a in addrs]
    if not lock_is:
        return False
    return addrs.index(addr) > max(lock_is)


def set_no_anim(addr: str, on: bool) -> None:
    addr = SAFE.safe_addr(addr)
    if not addr:
        return
    v = "1" if on else "0"
    hypr_eval(
        f'hl.dispatch(hl.dsp.window.set_prop({{ window = "address:{addr}", prop = "no_anim", value = "{v}" }}))'
    )


def pack_locked_left(ws: str, locked_addrs: set[str], manage_inhibit: bool = True) -> None:
    """Bubble extras left of locked panes to the right of them.

    Caller should debounce so a burst of extras is one pack, not a cascade.
    """
    locked = {SAFE.safe_addr(a) or "" for a in locked_addrs}
    locked.discard("")
    if not locked:
        return
    if not ensure_layout_workspace(str(ws)):
        return
    if manage_inhibit:
        layout_msg_on(str(ws), "inhibit_scroll true")
    try:
        stalled = 0
        for _ in range(6):
            addrs = _tiled_addr_order(str(ws))
            if not addrs:
                return
            lock_is = [addrs.index(a) for a in locked if a in addrs]
            if not lock_is:
                return
            before = [i for i, a in enumerate(addrs) if a not in locked and i < max(lock_is)]
            if not before:
                return
            victim = addrs[before[0]]
            prev_i = before[0]
            focus_window(victim)
            layout_msg_on(str(ws), "movewindowto r")
            time.sleep(0.06)
            after = _tiled_addr_order(str(ws))
            if victim in after and after.index(victim) <= prev_i:
                layout_msg_on(str(ws), "swapcol r")
                time.sleep(0.05)
                after = _tiled_addr_order(str(ws))
            if victim not in after:
                return
            new_i = after.index(victim)
            if new_i < prev_i:
                layout_msg_on(str(ws), "swapcol l")
                return
            if new_i <= prev_i:
                stalled += 1
                if stalled >= 2:
                    return
            else:
                stalled = 0
    finally:
        if manage_inhibit:
            layout_msg_on(str(ws), "inhibit_scroll false")


def push_column_after_locked(addr: str, ws: str, locked_addrs: set[str] | int) -> None:
    """Move a new column to the right of every locked pane (not between them).

    Bounded swaps only — a 16-step swapcol loop wraps the tape and looks like
    extras loading on the left then cascading right (live WS2).
    """
    addr = SAFE.safe_addr(addr) or ""
    if not addr:
        return
    if isinstance(locked_addrs, int):
        if locked_addrs < 1:
            return
        locked_set: set[str] = set()
        n_locked = locked_addrs
    else:
        locked_set = {SAFE.safe_addr(a) or "" for a in locked_addrs if a and a != addr}
        locked_set.discard("")
        if not locked_set:
            return
        n_locked = len(locked_set)
    if locked_set:
        pack_locked_left(str(ws), locked_set)
        return
    addrs = _tiled_addr_order(str(ws))
    if not addrs or addr not in addrs:
        return
    extra_i = addrs.index(addr)
    while extra_i < n_locked and extra_i + 1 < len(addrs):
        swap_windows(addrs[extra_i], addrs[extra_i + 1])
        time.sleep(0.02)
        addrs = _tiled_addr_order(str(ws))
        if addr not in addrs:
            return
        extra_i = addrs.index(addr)


def locked_colresize_frac(it: dict[str, Any], metrics: dict[str, float], extra_frac: float) -> float:
    """colresize is a fraction of monitor width. Prefer saved pixel width."""
    lw = float(metrics.get("lw") or metrics.get("w") or 1) or 1.0
    px = it.get("px") or {}
    w = float(px.get("w") or 0)
    if w >= 80:
        return max(0.08, min(0.98, round(w / lw, 4)))
    return column_width_frac(it, extra_frac)


def pin_locked_column_sizes(
    ws: str,
    locked_items: list[dict[str, Any]],
    extra_addr: str,
    extra_frac: float,
    metrics: dict[str, float],
    manage_inhibit: bool = True,
) -> None:
    """Keep locked panes at saved widths; only the extra uses Visible 1/N."""
    if not ensure_layout_workspace(str(ws)):
        return
    if manage_inhibit:
        layout_msg_on(str(ws), "inhibit_scroll true")
    try:
        for it in locked_items:
            addr = str(it.get("addr") or "")
            if not addr:
                continue
            force_tiled(addr)
            frac = locked_colresize_frac(it, metrics, extra_frac)
            focus_window(addr)
            layout_msg_on(str(ws), f"colresize {frac}")
            time.sleep(0.02)
        if extra_addr:
            clear_size_lock(extra_addr)
            focus_window(extra_addr)
            layout_msg_on(str(ws), f"colresize {extra_frac}")
            time.sleep(0.02)
        if locked_items:
            focus_window(str(locked_items[0].get("addr") or ""))
        cache_clear()
    finally:
        if manage_inhibit:
            layout_msg_on(str(ws), "inhibit_scroll false")


def append_extra_after_locked(ws: str, addr: str, cfg: dict[str, Any] | None = None, profile_id: str = "") -> dict[str, Any]:
    """Keep locked panes put. lua:workscape places extras after them; no swapcol."""
    addr = SAFE.safe_addr(addr) or addr
    if not addr:
        return {"ok": False, "error": "no addr"}
    if cfg is None:
        try:
            cfg = load_config(config_path())
        except Exception as exc:
            return {"ok": False, "error": str(exc)}
    profile = active_profile(cfg, profile_id)
    if not profile:
        return {"ok": False, "error": "no profile"}
    plan = lock_plan_for_workspace(profile, str(ws))
    locked = plan.get("locked") or []
    if len(locked) < 2:
        return {"ok": True, "skipped": True}
    if not uses_workscape_tape(plan):
        return {"ok": True, "skipped": True}
    vis = plan["visibleCount"]
    extra = extra_column_frac(vis)
    cache_clear()
    if workspace_tiled_layout(str(ws)) == "lua:workscape":
        return {"ok": True, "skipped": True, "reason": "already_tape", "workspace": str(ws), "addr": addr}
    monitors = hypr_j("monitors", cached=True)
    workspaces = hypr_j("workspaces", cached=True)
    mon = monitor_for_workspace(str(ws), monitors, workspaces)
    if not mon:
        return {"ok": False, "error": "no monitor"}
    metrics = layout_metrics(mon)
    cache_clear()
    on_ws = clients_on_workspace(str(ws))
    locked_items = match_locked_items(str(ws), plan, metrics, on_ws)
    locked_addrs = {it["addr"] for it in locked_items}
    if addr in locked_addrs:
        return {"ok": True, "skipped": True, "reason": "locked"}
    push_workscape_plan(str(ws), locked_items, extra, on_ws, mark_fresh=False, reset_offset=False)
    force_workscape_layout(str(ws))
    return {"ok": True, "workspace": str(ws), "addr": addr, "mode": "lua:workscape"}


def size_new_scrolling_column(
    ws: str,
    addr: str,
    visible_count: int,
    stage: bool = False,
    set_width: bool = False,
) -> None:
    extra = extra_column_frac(visible_count) if set_width else peeked_column_frac(visible_count)
    cache_clear()
    tiled = [c for c in clients_on_workspace(ws) if not c.get("floating")]
    n = len(tiled)
    locked_addrs: set[str] = set()
    try:
        cfg = load_config(config_path())
        profile = active_profile(cfg)
        if profile:
            plan = lock_plan_for_workspace(profile, str(ws))
            used: set[str] = set()
            on_ws = clients_on_workspace(str(ws))
            for assignment in plan.get("locked") or []:
                hit = match_client(assignment, on_ws, used)
                if hit and hit.get("address"):
                    used.add(hit["address"])
                    locked_addrs.add(str(hit["address"]))
    except Exception:
        locked_addrs = set()
    n_locked = len(locked_addrs)
    restamp_scrolling_default(ws, visible_count, lock=n_locked > 1, stage=stage, n_cols=n, set_width=set_width)
    if not addr:
        return
    addr = SAFE.safe_addr(addr) or addr
    if locked_addrs and addr not in {SAFE.safe_addr(a) or a for a in locked_addrs}:
        push_column_after_locked(addr, str(ws), locked_addrs)
    if set_width:
        # colresize all is a layoutmsg: it hits the *active* workspace.
        # Activating WS3 to send it (ensure_layout_workspace) focuses the
        # first column and drops the camera (I-043). Only resize when the
        # user is already looking at this workspace.
        try:
            aw = hypr_j("activeworkspace")
            already = str((aw or {}).get("id") or "") == str(ws)
        except Exception:
            already = False
        if already:
            layout_msg(f"colresize all {extra}")
        return
    if not ensure_layout_workspace(str(ws)):
        return
    focus_window(addr)
    if n > 1:
        layout_msg_on(str(ws), f"colresize {extra}")
        return
    if stage:
        layout_msg_on(str(ws), f"colresize {stage_fill_frac()}")
        return
    layout_msg_on(str(ws), f"colresize {extra}")


def force_scrolling(
    ws: str,
    visible_count: int = 2,
    lock: bool = True,
    stage: bool = False,
    persist: bool = False,
    fill_one: bool = False,
) -> None:
    ws = SAFE.safe_ws(ws)
    if not ws:
        return
    _ = (lock, stage, fill_one)
    opts = scrolling_layout_opts(visible_count)
    persist_s = "true" if persist else "false"
    hypr_eval(
        f'hl.workspace_rule({{ workspace = "{ws}", persistent = {persist_s}, layout = "scrolling", '
        f"layout_opts = {{ {opts} }} }})"
    )


def force_dwindle(ws: str) -> None:
    ws = SAFE.safe_ws(ws)
    if not ws:
        return
    hypr_eval(f'hl.workspace_rule({{ workspace = "{ws}", persistent = false, layout = "dwindle" }})')


def uses_workscape_tape(plan: dict[str, Any]) -> bool:
    """Removed. Two-lock tape is no longer a layout."""
    _ = plan
    return False


def workspace_tiled_layout(ws: str) -> str:
    try:
        for w in hypr_j("workspaces", cached=True) or []:
            if str(w.get("id")) == str(ws) or str(w.get("name")) == str(ws):
                return str(w.get("tiledLayout") or "")
    except Exception:
        pass
    return ""


def reset_workscape_layout_cache() -> None:
    global _layout_ready
    _layout_ready = False


def ensure_workscape_layout() -> None:
    """Load Super+arrow overlay. No custom layout."""
    global _layout_ready
    if _layout_ready:
        return
    hypr_eval('pcall(function() require("hypr.workscape-binds") end)')
    _layout_ready = True


def force_workscape_layout(ws: str, persist: bool = False) -> None:
    _ = persist
    force_dwindle(ws)


def _lua_quote(s: str) -> str:
    return '"' + SAFE.lua_str(s) + '"'


def push_workscape_plan(
    ws: str,
    locked_items: list[dict[str, Any]],
    extra_frac: float,
    clients: list[dict[str, Any]] | None = None,
    mark_fresh: bool = True,
    reset_offset: bool = True,
) -> None:
    """Publish locked fractions so lua:workscape can place without layoutmsg.

    Extra-open must not set fresh or reset the tape camera (I-035).
    """
    ws = str(ws or "")
    if not SAFE.safe_ws(ws):
        return
    extra_frac = max(0.08, min(0.98, float(extra_frac)))
    by_addr: dict[str, dict[str, Any]] = {}
    for c in clients or []:
        addr = str(c.get("address") or "")
        if addr:
            by_addr[addr] = c
    parts: list[str] = []
    for it in locked_items:
        addr = str(it.get("addr") or "")
        hit = by_addr.get(addr) or {}
        cls = str(hit.get("class") or hit.get("initialClass") or "")
        title = str(hit.get("title") or "")
        frac = column_width_frac(it, extra_frac)
        parts.append(
            "{ class = "
            + _lua_quote(cls)
            + ", title = "
            + _lua_quote(title)
            + ", address = "
            + _lua_quote(addr)
            + f", w = {round(frac, 4)} }}"
        )
    locked_lua = ", ".join(parts)
    ws_q = _lua_quote(ws)
    lines = [
        'pcall(function() require("hypr.workscape-layout") end)',
        "Workscape = Workscape or { plans = {}, offsets = {}, extraIds = {}, fresh = {} }",
        "Workscape.plans[" + ws_q + "] = { extraFrac = " + str(round(extra_frac, 4)) + ", locked = { " + locked_lua + " } }",
    ]
    if mark_fresh:
        lines.append("Workscape.fresh = Workscape.fresh or {}")
        lines.append("Workscape.fresh[" + ws_q + "] = true")
    if reset_offset:
        lines.append("Workscape.offsets[" + ws_q + "] = 0")
    global _layout_ready
    _layout_ready = True
    hypr_eval(" ".join(lines))


def match_locked_items(
    ws: str,
    plan: dict[str, Any],
    metrics: dict[str, float],
    clients: list[dict[str, Any]] | None = None,
) -> list[dict[str, Any]]:
    locked = plan.get("locked") or []
    on_ws = clients if clients is not None else clients_on_workspace(str(ws))
    used: set[str] = set()
    items: list[dict[str, Any]] = []
    for i, assignment in enumerate(locked):
        hit = match_client(assignment, on_ws, used)
        if not hit or not hit.get("address"):
            continue
        used.add(hit["address"])
        g = assignment.get("geom") or fallback_geom(i, len(locked))
        items.append({
            "addr": str(hit["address"]),
            "geom": g,
            "px": tile_px(hit["address"], g, metrics),
            "name": assignment.get("name"),
            "lock": True,
            "class": str(hit.get("class") or hit.get("initialClass") or ""),
            "title": str(hit.get("title") or ""),
        })
    return items


def place_workscape_tape(
    ws: str,
    plan: dict[str, Any],
    metrics: dict[str, float],
    prefer_addr: str = "",
) -> list[dict[str, Any]]:
    """Ask lua:workscape to place; do not swapcol/colresize/focus extras."""
    cache_clear()
    on_ws = clients_on_workspace(str(ws))
    items = match_locked_items(str(ws), plan, metrics, on_ws)
    locked_addrs = {it["addr"] for it in items}
    for it in items:
        force_tiled(it["addr"])
        clear_size_lock(it["addr"])
    for c in on_ws:
        addr = str(c.get("address") or "")
        if not addr or addr in locked_addrs:
            continue
        if c.get("floating"):
            force_tiled(addr)
            clear_size_lock(addr)
    extra = extra_column_frac(plan.get("visibleCount") or 2)
    push_workscape_plan(str(ws), items, extra, on_ws)
    already = workspace_tiled_layout(str(ws)) == "lua:workscape"
    force_workscape_layout(str(ws))
    if already and items:
        addr = SAFE.safe_addr(str(items[0].get("addr") or "")) or ""
        if addr:
            hypr_eval(
                f'hl.dispatch(hl.dsp.window.resize({{ window = "address:{addr}", x = 0, y = 0, relative = true }}))'
            )
    time.sleep(0.05)
    cache_clear()
    locked_addrs = {it["addr"] for it in items}
    extras: list[dict[str, Any]] = []
    for c in clients_on_workspace(str(ws)):
        addr = str(c.get("address") or "")
        if not addr or addr in locked_addrs or c.get("floating"):
            continue
        g = {"x": 1.0, "y": 0.0, "w": extra, "h": 1.0}
        extras.append({"addr": addr, "geom": g, "px": geom_pixels(g, metrics), "lock": False})
    sequence = items + extras
    _ = prefer_addr
    return [{**it, "place": actual_box(it["addr"]) or it.get("px") or {}} for it in sequence]


def active_window_addr() -> str | None:
    try:
        w = hypr_j("activewindow")
        if isinstance(w, dict):
            addr = w.get("address")
            return str(addr) if addr else None
    except Exception:
        return None
    return None


def focus_window(addr: str) -> None:
    addr = SAFE.safe_addr(addr) or ""
    if not addr:
        return
    # layoutmsg always hits the *active* workspace. On a dock, focusing a
    # window on another monitor may leave the laptop workspace active — then
    # colresize/fit/expel cut off unassigned windows (e.g. WS5).
    c = client_by_addr(addr)
    if c:
        ws = str((c.get("workspace") or {}).get("id") or "")
        mon_id = c.get("monitor")
        if mon_id is not None:
            try:
                for m in hypr_j("monitors", cached=True) or []:
                    if m.get("id") == mon_id:
                        name = SAFE.safe_connector(str(m.get("name") or ""))
                        if name:
                            hypr_eval(f'hl.dispatch(hl.dsp.focus({{ monitor = "{name}" }}))')
                        break
            except Exception:
                pass
        if ws:
            hypr_eval(f'hl.dispatch(hl.dsp.focus({{ workspace = "{ws}" }}))')
    hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "address:{addr}" }}))')


def focus_workspace(ws: str) -> None:
    if not ws:
        return
    hypr_eval(f'hl.dispatch(hl.dsp.focus({{ workspace = "{ws}" }}))')


def activate_workspace_for_layout(ws: str) -> bool:
    """Make `ws` the active workspace on its monitor so layoutmsg hits it."""
    ws = str(ws or "")
    if not SAFE.safe_ws(ws):
        return False
    try:
        cache_clear()
        mon = monitor_for_workspace(ws, hypr_j("monitors", cached=True), hypr_j("workspaces", cached=True))
        if mon:
            name = SAFE.safe_connector(str(mon.get("name") or ""))
            if name:
                hypr_eval(f'hl.dispatch(hl.dsp.focus({{ monitor = "{name}" }}))')
        focus_workspace(ws)
        time.sleep(0.05)
        cache_clear()
        aw = hypr_j("activeworkspace")
        return str((aw or {}).get("id") or "") == ws
    except Exception:
        return False


def ensure_layout_workspace(ws: str, attempts: int = 6) -> bool:
    """Retry activate until `ws` is active. False means do not layoutmsg (would hit the user's WS)."""
    ws = SAFE.safe_ws(ws) or ""
    if not ws:
        return False
    if ws not in managed_workspaces():
        return False
    for _ in range(max(1, attempts)):
        if activate_workspace_for_layout(ws):
            return True
        time.sleep(0.04)
    return False


def layout_msg_on(ws: str, msg: str) -> bool:
    """Send layoutmsg only after `ws` is the active managed workspace."""
    if not ensure_layout_workspace(ws):
        return False
    layout_msg(msg)
    return True


def managed_workspaces(profile: dict[str, Any] | None = None) -> set[str]:
    """Workspaces this profile actually lays out. Never layoutmsg anywhere else."""
    if profile is None:
        try:
            profile = active_profile(load_config(config_path()))
        except Exception:
            return set()
    if not profile:
        return set()
    out: set[str] = set()
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        ws = str(a.get("workspace") or "")
        if ws:
            out.add(ws)
    for key, pref in (profile.get("workspacePrefs") or {}).items():
        if isinstance(pref, dict) and pref.get("layout") in ("scrolling", "master", "dwindle", "stage", "set-width"):
            out.add(str(key))
    return out


def _user_managed_workspaces() -> set[str]:
    """Always include the on-disk user profile so dummy tests cannot dwindle WS1–4."""
    override = os.environ.get("WORKSCAPE_CONFIG", "").strip()
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    user = str(Path(state) / "omarchy/workscape/config.json")
    if not override or os.path.abspath(override) == os.path.abspath(user):
        return set()
    try:
        return managed_workspaces(active_profile(load_config(user)))
    except Exception:
        return set()


def covers_work_area(box: dict[str, Any] | None, metrics: dict[str, float] | None) -> bool:
    """True if box is the usable monitor pane (full-size overlay or filled tile)."""
    if not isinstance(box, dict) or not isinstance(metrics, dict):
        return False
    return (
        abs(int(box.get("x") or 0) - int(metrics.get("x") or 0)) <= 40
        and abs(int(box.get("w") or 0) - int(metrics.get("w") or 0)) <= 80
        and abs(int(box.get("h") or 0) - int(metrics.get("h") or 0)) <= 80
    )


def tile_covering_floats(ws: str) -> list[str]:
    """Tile full-monitor floats on `ws`. Session overlays (I-031), not small dialogs."""
    ws = SAFE.safe_ws(ws) or ""
    if not ws:
        return []
    cache_clear()
    try:
        mons = hypr_j("monitors")
        spaces = hypr_j("workspaces")
    except Exception:
        return []
    mon = monitor_for_workspace(ws, mons, spaces)
    if not mon:
        return []
    metrics = layout_metrics(mon)
    done: list[str] = []
    for c in clients_on_workspace(ws):
        if c.get("floating") is not True:
            continue
        addr = str(c.get("address") or "")
        box = actual_box(addr)
        if not box or not covers_work_area(box, metrics):
            continue
        force_tiled(addr)
        done.append(addr)
    return done


def fill_window_to_monitor(addr: str, metrics: dict[str, float]) -> None:
    """Resize/move a tiled window. Never grow a float into a full-size overlay."""
    force_tiled(addr)
    cache_clear()
    c = client_by_addr(addr)
    if not c or c.get("floating") is True:
        return
    box = actual_box(addr)
    if not box:
        return
    dx = int(metrics["w"]) - int(box.get("w") or 0)
    dy = int(metrics["h"]) - int(box.get("h") or 0)
    if abs(dx) >= 8 or abs(dy) >= 8:
        resize_relative(addr, dx, dy)
        cache_clear()
        box = actual_box(addr) or box
    mx = int(metrics["x"]) - int(box.get("x") or 0)
    my = int(metrics["y"]) - int(box.get("y") or 0)
    if abs(mx) >= 4 or abs(my) >= 4:
        hypr_eval(
            f'hl.dispatch(hl.dsp.window.move({{ window = "address:{addr}", x = {int(mx)}, y = {int(my)}, relative = true }}))'
        )


def repair_unmanaged_workspaces(also_keep: set[str] | None = None) -> None:
    """Unassigned sessions (Grok CLI on WS5/8) must stay dwindle tiles, not overlays."""
    keep = set(managed_workspaces())
    keep |= _user_managed_workspaces()
    if also_keep:
        keep |= {str(x) for x in also_keep}
    cache_clear()
    try:
        spaces = hypr_j("workspaces")
        mons = hypr_j("monitors")
    except Exception:
        return
    for w in spaces or []:
        ws = str(w.get("id") or "")
        if not ws or ws in keep:
            continue
        force_dwindle(ws)
        tile_covering_floats(ws)
        cache_clear()
        on = [c for c in clients_on_workspace(ws) if not c.get("floating")]
        if len(on) != 1:
            continue
        mon = monitor_for_workspace(ws, mons, spaces)
        if not mon:
            continue
        metrics = layout_metrics(mon)
        box = actual_box(str(on[0].get("address") or ""))
        if not box:
            continue
        if covers_work_area(box, metrics):
            continue
        fill_window_to_monitor(str(on[0]["address"]), metrics)


def layout_msg(msg: str) -> None:
    # layoutmsg always hits the active workspace. Abort unless that workspace
    # is managed. Do not retarget to the previously focused window — that
    # sent colresize/expel to the laptop session (I-014) and undid dummy
    # settle on WS 11–19.
    try:
        aw = hypr_j("activeworkspace")
        cur = str((aw or {}).get("id") or "")
        if cur not in managed_workspaces():
            return
    except Exception:
        return
    safe = str(msg).replace("\\", "\\\\").replace('"', '\\"')
    hypr_eval(f'hl.dispatch(hl.dsp.layout("{safe}"))')


def client_workspace_id(addr: str) -> str:
    c = client_by_addr(addr)
    if not c:
        return ""
    w = c.get("workspace") or {}
    return str(w.get("id") or w.get("name") or "")


def ensure_width(addr: str, want_w: int) -> None:
    cache_clear()
    box = actual_box(addr)
    if not box:
        return
    dx = int(want_w) - int(box.get("w") or 0)
    if abs(dx) >= 4:
        resize_relative(addr, dx, 0)


def client_by_addr(addr: str) -> dict[str, Any] | None:
    want = SAFE.safe_addr(addr)
    if not want:
        return None
    for c in hypr_j("clients", cached=True):
        got = SAFE.safe_addr(str(c.get("address") or ""))
        if got == want:
            return c
    return None


def actual_box(addr: str) -> dict[str, int] | None:
    c = client_by_addr(addr)
    if not c:
        return None
    at = c.get("at") or [0, 0]
    size = c.get("size") or [0, 0]
    return {"x": int(at[0]), "y": int(at[1]), "w": int(size[0]), "h": int(size[1])}


def apply_tiled_split(items: list[dict[str, Any]], metrics: dict[str, float]) -> list[dict[str, Any]]:
    """Keep windows tiled and set the shared dwindle/master split from geoms."""
    for it in items:
        force_tiled(it["addr"])
    cache_clear()
    time.sleep(0.03)
    if len(items) < 2:
        if not items:
            return []
        it = items[0]
        box = actual_box(it["addr"])
        want = it.get("px") or {}
        if box and want:
            dx = int(want.get("w") or 0) - int(box.get("w") or 0)
            dy = int(want.get("h") or 0) - int(box.get("h") or 0)
            if abs(dx) >= 4 or abs(dy) >= 4:
                resize_relative(it["addr"], dx, dy)
                cache_clear()
                time.sleep(0.03)
                box = actual_box(it["addr"]) or box
        return [{**it, "place": box or it["px"]}]

    geoms = [it.get("geom") or {} for it in items]
    side_by_side = all(abs(float(g.get("h") or 1) - 1) < 0.08 and float(g.get("y") or 0) < 0.08 for g in geoms)
    stacked = all(abs(float(g.get("w") or 1) - 1) < 0.08 and float(g.get("x") or 0) < 0.08 for g in geoms)

    if side_by_side:
        ordered = sorted(items, key=lambda it: float((it.get("geom") or {}).get("x") or 0))
        axis = "x"
        size_idx = 0
        want_key = "w"
    elif stacked:
        ordered = sorted(items, key=lambda it: float((it.get("geom") or {}).get("y") or 0))
        axis = "y"
        size_idx = 1
        want_key = "h"
    else:
        return [{**it, "place": actual_box(it["addr"]) or it["px"]} for it in items]

    # Visual order must match geom order so the split resize hits the right pane.
    for _ in range(len(ordered)):
        live = [actual_box(it["addr"]) for it in ordered]
        if not all(live):
            break
        swapped = False
        for i in range(len(ordered) - 1):
            a = live[i][axis]
            b = live[i + 1][axis]
            if a > b + 4:
                swap_windows(ordered[i]["addr"], ordered[i + 1]["addr"])
                cache_clear()
                time.sleep(0.03)
                swapped = True
                break
        if not swapped:
            break

    left = ordered[0]
    box = actual_box(left["addr"])
    if not box:
        return [{**it, "place": it["px"]} for it in ordered]
    want = int(left["px"][want_key])
    cur = int(box["w"] if axis == "x" else box["h"])
    delta = want - cur
    if abs(delta) >= 4:
        if axis == "x":
            resize_relative(left["addr"], delta, 0)
        else:
            resize_relative(left["addr"], 0, delta)
        cache_clear()
        time.sleep(0.03)

    out = []
    for it in ordered:
        box = actual_box(it["addr"]) or it["px"]
        if box:
            clear_size_lock(it["addr"])
        out.append({**it, "place": box})
    return out


def workspace_is_scrolling(ws: str, workspaces: list[dict[str, Any]] | None = None) -> bool:
    for w in workspaces if workspaces is not None else hypr_j("workspaces", cached=True):
        if str(w.get("id")) == str(ws) or str(w.get("name")) == str(ws):
            return str(w.get("tiledLayout") or "") == "scrolling"
    return False


def apply_items(items: list[dict[str, Any]], metrics: dict[str, float], ws: str = "") -> list[dict[str, Any]]:
    if not items:
        return []
    if ws and workspace_is_scrolling(ws):
        return place_scrolling_columns(items, metrics, ws, 0.5)
    return apply_tiled_split(items, metrics)


def clients_on_workspace(ws: str) -> list[dict[str, Any]]:
    out = []
    for c in hypr_j("clients", cached=True):
        w = c.get("workspace") or {}
        if str(w.get("id")) == str(ws) or str(w.get("name")) == str(ws):
            out.append(c)
    return out


def sort_clients_axis(clients: list[dict[str, Any]], axis: str) -> list[dict[str, Any]]:
    idx = 0 if axis == "x" else 1
    return sorted(clients, key=lambda c: ((c.get("at") or [0, 0]) + [0, 0])[idx])


def pin_locked_order(ordered: list[dict[str, Any]], ws: str, axis: str) -> None:
    """Put locked panes at the front of the axis so extras land after them."""
    for rank, it in enumerate(ordered):
        cache_clear()
        live = sort_clients_axis(clients_on_workspace(ws), axis)
        if rank >= len(live):
            break
        current = live[rank].get("address")
        if current == it["addr"]:
            continue
        swap_windows(it["addr"], current)
        time.sleep(0.03)


def column_rank(addr: str, ws: str, tol: int = 24) -> int | None:
    live = [c for c in clients_on_workspace(ws) if not c.get("floating")]
    if not live:
        return None
    ordered = sorted(live, key=lambda c: int(((c.get("at") or [0, 0]) + [0, 0])[0]))
    cols: list[list[dict[str, Any]]] = []
    for c in ordered:
        x = int(((c.get("at") or [0, 0]) + [0, 0])[0])
        if cols and abs(x - int(((cols[-1][0].get("at") or [0, 0]) + [0, 0])[0])) <= tol:
            cols[-1].append(c)
        else:
            cols.append([c])
    for i, group in enumerate(cols):
        if any(c.get("address") == addr for c in group):
            return i
    return None


def column_collapsed(addr: str) -> bool:
    box = actual_box(addr)
    return not box or int(box.get("w") or 0) < 40


def stacked_with_other(addr: str, ws: str, tol: int = 24) -> bool:
    box = actual_box(addr)
    if not box:
        return False
    x = int(box.get("x") or 0)
    for c in clients_on_workspace(ws):
        other = c.get("address")
        if not other or other == addr or c.get("floating"):
            continue
        at = c.get("at") or [0, 0]
        if abs(int(at[0]) - x) <= tol:
            return True
    return False


def place_scrolling_columns(
    items: list[dict[str, Any]],
    metrics: dict[str, float],
    ws: str,
    extra_frac: float,
    prefer_addr: str = "",
    visible_count: int = 0,
    stage: bool = False,
    set_width: bool = False,
) -> list[dict[str, Any]]:
    """Locked columns keep geom width; extras become new tape columns at extra_frac.

    Never pixel-resize when extras exist: relative resize steals from the extra
    until its width goes negative and the window vanishes.
    """
    extra_frac = max(0.05, min(1.0, float(extra_frac)))
    vis = clamp_visible_count(visible_count) if visible_count else clamp_visible_count(int(round(1.0 / extra_frac)))
    activate_workspace_for_layout(str(ws))
    cache_clear()
    locked_addrs = {it["addr"] for it in items if it.get("addr")}
    extras: list[dict[str, Any]] = []
    for c in clients_on_workspace(ws):
        addr = c.get("address")
        if not addr or addr in locked_addrs or c.get("floating"):
            continue
        g = {"x": 1.0, "y": 0.0, "w": extra_frac, "h": 1.0}
        extras.append({"addr": addr, "geom": g, "px": geom_pixels(g, metrics), "lock": False})
    ordered_locked = sorted(
        items,
        key=lambda it: (
            float((it.get("geom") or {}).get("x") or 0),
            float((it.get("geom") or {}).get("y") or 0),
        ),
    )
    sequence = ordered_locked + extras
    if not sequence:
        return []
    prev = active_window_addr()
    has_extras = bool(extras)
    extra_addrs = {it["addr"] for it in extras}
    anchor = ""
    if prefer_addr and prefer_addr in extra_addrs:
        anchor = prefer_addr
    elif prev and prev in extra_addrs:
        anchor = prev
    elif extras:
        anchor = extras[-1]["addr"]
    # Keep the new extra focused. inhibit_scroll before touching locked
    # columns so follow_focus does not pan to Herdr then jump back.
    if anchor:
        focus_window(anchor)
    elif prev and client_workspace_id(prev) == str(ws):
        focus_window(prev)
    else:
        focus_workspace(str(ws))
    layout_msg("inhibit_scroll true")
    try:
        for it in extras:
            force_tiled(it["addr"])
            clear_size_lock(it["addr"])
            focus_window(it["addr"])
            layout_msg("expel")
            time.sleep(0.02)
        for it in ordered_locked:
            force_tiled(it["addr"])
            clear_size_lock(it["addr"])
            if stacked_with_other(it["addr"], ws):
                focus_window(it["addr"])
                layout_msg("expel")
                time.sleep(0.04)
        last_locked = len(ordered_locked)
        locked_fracs = [column_width_frac(it, extra_frac) for it in ordered_locked]
        if not has_extras and locked_fracs:
            total = sum(locked_fracs)
            if total > 0.02 and abs(total - 1.0) >= 0.02:
                locked_fracs = [round(f / total, 4) for f in locked_fracs]
            locked_fracs = fit_column_fracs(locked_fracs, metrics, len(locked_fracs))
        locked_addr_set = {it["addr"] for it in ordered_locked if it.get("addr")}
        for it in extras:
            push_column_after_locked(it["addr"], ws, locked_addr_set)
        for it, frac in zip(ordered_locked, locked_fracs):
            focus_window(it["addr"])
            layout_msg(f"colresize {frac}")
            time.sleep(0.015)
        for it in extras:
            focus_window(it["addr"])
            layout_msg(f"colresize {extra_frac}")
            time.sleep(0.015)
            if column_collapsed(it["addr"]):
                focus_window(it["addr"])
                layout_msg("expel")
                layout_msg(f"colresize {extra_frac}")
                time.sleep(0.015)
        stay = ""
        if extras:
            stay = anchor or extras[-1]["addr"]
        elif ordered_locked:
            stay = ordered_locked[0]["addr"]
        elif sequence:
            stay = sequence[0]["addr"]
        if stay:
            focus_window(stay)
        if not has_extras:
            clamp_scrolling_to_monitor(ws, metrics, ordered_locked)
        restamp_scrolling_default(
            ws,
            vis,
            lock=bool(ordered_locked),
            stage=stage,
            n_cols=len(sequence),
            set_width=set_width,
        )
    finally:
        # inhibit_scroll is a scrolling layoutmsg. Sending it after focusing a
        # dwindle/master workspace (e.g. after Apply) raises a Hyprland config error.
        layout_msg("inhibit_scroll false")
    if extras:
        focus_window(anchor or extras[-1]["addr"])
    elif not has_extras and ordered_locked:
        focus_window(ordered_locked[0]["addr"])
    cache_clear()
    return [{**it, "place": actual_box(it["addr"]) or it.get("px") or {}} for it in sequence]


def place_locked_windows(items: list[dict[str, Any]], metrics: dict[str, float], ws: str, extra_frac: float = 0.5) -> list[dict[str, Any]]:
    """Restore locked panes as scrolling columns so they cannot cover each other."""
    return place_scrolling_columns(items, metrics, ws, extra_frac)


def fallback_geom(index: int, count: int) -> dict[str, float]:
    n = max(1, int(count))
    w = round(1.0 / n, 4)
    return {"x": round(index * w, 4), "y": 0.0, "w": w, "h": 1.0}


def close_enough(box: dict[str, int] | None, want: dict[str, int] | None, tol: int = 12) -> bool:
    if not box or not want:
        return False
    return abs(int(box.get("w") or 0) - int(want.get("w") or 0)) <= tol and abs(
        int(box.get("h") or 0) - int(want.get("h") or 0)
    ) <= tol


def restamp_layout_sizes(ws: str, profile: dict[str, Any] | None = None) -> dict[str, Any]:
    """Stamp native workspace layout + spawn width. No colresize/peek."""
    ws = str(ws)
    if profile is None:
        try:
            profile = active_profile(load_config(config_path()))
        except Exception as exc:
            return {"ok": False, "error": str(exc)}
    if not profile:
        return {"ok": False, "error": "no profile"}
    plan = lock_plan_for_workspace(profile, ws)
    vis = int(plan.get("visibleCount") or 2)
    extra = extra_column_frac(vis)
    layout = str(plan.get("layout") or "dwindle")
    if layout == "scrolling":
        force_scrolling(ws, vis)
        apply_spawn_width_rule(ws, extra)
        return {"ok": True, "mode": "scrolling", "workspace": ws}
    if layout == "master":
        hypr_eval(
            f'hl.workspace_rule({{ workspace = "{SAFE.safe_ws(ws)}", persistent = false, layout = "master", '
            'layout_opts = { orientation = "left" } })'
        )
        apply_spawn_width_rule(ws, None)
        return {"ok": True, "mode": "master", "workspace": ws}
    if plan.get("locked") and plan.get("extras") == "block":
        return _settle_workspace_once(ws, plan)
    force_dwindle(ws)
    apply_spawn_width_rule(ws, None)
    if plan.get("locked"):
        return _settle_workspace_once(ws, plan)
    return {"ok": True, "mode": "dwindle", "workspace": ws}


def group_plan_for_workspace(profile: dict[str, Any], ws: str) -> list[list[dict[str, Any]]]:
    """Assignments per Hyprland group on this workspace, in stored tab order.

    Groups of one are dropped: a lone member is an ordinary tile.
    """
    order: list[str] = []
    by_token: dict[str, list[dict[str, Any]]] = {}
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        if str(a.get("workspace") or "") != str(ws):
            continue
        token = str(a.get("group") or "")
        if not token:
            continue
        if token not in by_token:
            by_token[token] = []
            order.append(token)
        by_token[token].append(a)
    return [by_token[t] for t in order if len(by_token[t]) > 1]


def _group_member_addrs(addr: str, cached: bool = False) -> list[str]:
    """Addresses Hyprland reports as sharing a group with `addr`."""
    for c in hypr_j("clients", cached=cached) or []:
        if str(c.get("address") or "") == addr:
            return [str(a) for a in (c.get("grouped") or []) if a]
    return []


def add_window_to_group(ws: str, host_addr: str, addr: str) -> bool:
    """Put `addr` into the group that `host_addr` already belongs to.

    Uses the Lua object API rather than a dispatcher on purpose:
    hl.dsp.group.move_window() is a silent no-op here (it moves nothing for any
    argument shape tried, with or without a clean neighbour in the direction
    given), while Workspace:get_groups() plus Group:add() is deterministic and
    also works for a window that was already running, which is the common case
    once Apply reuses windows instead of launching them.
    """
    ws_s = SAFE.safe_ws(ws)
    host = SAFE.safe_addr(host_addr)
    member = SAFE.safe_addr(addr)
    if not ws_s or not host or not member or host == member:
        return False
    hypr_eval(
        f'local ws = hl.get_workspace("{ws_s}") '
        "if ws == nil then return end "
        f'local w = hl.get_window("address:{member}") '
        "if w == nil then return end "
        "for _, g in ipairs(ws:get_groups() or {}) do "
        "  for _, m in ipairs(g.members or {}) do "
        f'    if m.address == "{host}" then g:add(w) return end '
        "  end "
        "end"
    )
    cache_clear()
    return member in _group_member_addrs(host)


def ensure_groups_for_workspace(
    ws: str, profile: dict[str, Any], clients: list[dict[str, Any]] | None = None
) -> list[dict[str, Any]]:
    """Rebuild this workspace's stored groups from whatever is running.

    Runs before the tiled split so the layout is computed for one tile per
    group. Windows that are not running are simply skipped; a group needs two
    present members to be worth creating.
    """
    plan = group_plan_for_workspace(profile, str(ws))
    if not plan:
        return []
    if clients is None:
        clients = hypr_j("clients") or []
    on_ws = [
        c for c in clients
        if str((c.get("workspace") or {}).get("id")) == str(ws)
        or str((c.get("workspace") or {}).get("name")) == str(ws)
    ]
    out: list[dict[str, Any]] = []
    used: set[str] = set()
    for members in plan:
        matched: list[tuple[dict[str, Any], str]] = []
        for a in members:
            hit = match_client(a, on_ws, used)
            if not hit:
                continue
            used.add(hit["address"])
            matched.append((a, str(hit["address"])))
        token = str(members[0].get("group") or "")
        if len(matched) < 2:
            out.append({"group": token, "ok": False, "reason": "fewer than two windows present",
                        "matched": len(matched)})
            continue
        head_addr = matched[0][1]
        # Make the first member a group, unless it already is one.
        if len(_group_member_addrs(head_addr)) < 1:
            focus_window(head_addr)
            hypr_eval("hl.dispatch(hl.dsp.group.toggle())")
            cache_clear()
        added = [head_addr]
        for _, addr in matched[1:]:
            if addr in _group_member_addrs(head_addr):
                added.append(addr)
                continue
            if add_window_to_group(str(ws), head_addr, addr):
                added.append(addr)
        # The tab on top is whichever member was focused last, so focus the one
        # the profile marks active. Apply restores the caller's focus at the end.
        active_addr = ""
        for a, addr in matched:
            if a.get("groupActive") is True:
                active_addr = addr
        if active_addr and active_addr in added:
            focus_window(active_addr)
        out.append({
            "group": token,
            "ok": len(added) >= 2,
            "members": added,
            "active": active_addr,
        })
    cache_clear()
    return out


def restore_locks_for_workspace(
    ws: str,
    cfg: dict[str, Any] | None = None,
    profile_id: str = "",
    prefer_addr: str = "",
    keep_focus: bool = False,
) -> dict[str, Any]:
    """Re-apply locked pane sizes after Hyprland splits on a new window."""
    prev_addr = active_window_addr() if keep_focus else None
    prev_ws = ""
    if keep_focus:
        try:
            aw = hypr_j("activeworkspace")
            if isinstance(aw, dict):
                prev_ws = str(aw.get("id") or "")
        except Exception:
            prev_ws = ""
    if cfg is None:
        path = config_path()
        try:
            cfg = load_config(path)
        except Exception as exc:
            return {"ok": False, "error": str(exc)}
    profile = active_profile(cfg, profile_id)
    if not profile:
        return {"ok": False, "error": "no profile"}
    if occupied_skip(str(ws), profile):
        return {"ok": True, "skipped": True, "workspace": str(ws), "reason": "occupied"}
    # Groups first: they turn several windows into one tile, so the split below
    # has to be computed after they exist.
    groups = ensure_groups_for_workspace(str(ws), profile)
    plan = lock_plan_for_workspace(profile, str(ws))
    locked = plan["locked"]
    if not locked:
        out = restamp_layout_sizes(str(ws), profile)
        if groups:
            out["groups"] = groups
        return out
    result = _settle_workspace_once(str(ws), plan, prefer_addr)
    if result.get("closeEnough") is False:
        time.sleep(0.1)
        cache_clear()
        result = _settle_workspace_once(str(ws), plan, prefer_addr)
    repair_unmanaged_workspaces(also_keep={str(ws)})
    for it in (result.get("windows") or []):
        clear_size_lock(str(it.get("addr") or ""))
    if keep_focus:
        cache_clear()
        if prev_addr and client_by_addr(prev_addr):
            focus_window(prev_addr)
        elif prev_ws:
            focus_workspace(prev_ws)
    if groups:
        result["groups"] = groups
    return result


def _settle_workspace_once(ws: str, plan: dict[str, Any], prefer_addr: str = "") -> dict[str, Any]:
    """One apply-time pass. Scrolling: spawn width only. Dwindle: split from geoms."""
    _ = prefer_addr
    cache_clear()
    locked = plan["locked"]
    n_lock = len(locked)
    layout = str(plan.get("layout") or "dwindle")
    locked_geoms = [a for a in locked if a.get("geom")]
    # Two locked panes are a split: dwindle + pixel sizes. Scrolling would
    # ignore those geoms and show equal columns (visibleCount 2 → 50/50).
    if len(locked_geoms) >= 2:
        layout = "dwindle"
    use_scrolling = layout == "scrolling"
    if use_scrolling:
        force_scrolling(ws, plan["visibleCount"])
        apply_spawn_width_rule(ws, extra_column_frac(plan["visibleCount"]))
    elif layout == "master":
        hypr_eval(
            f'hl.workspace_rule({{ workspace = "{SAFE.safe_ws(ws)}", persistent = false, layout = "master", '
            'layout_opts = { orientation = "left" } })'
        )
    else:
        force_dwindle(ws)
    time.sleep(0.05)
    cache_clear()
    monitors = hypr_j("monitors", cached=True)
    workspaces = hypr_j("workspaces", cached=True)
    mon = monitor_for_workspace(ws, monitors, workspaces)
    if not mon:
        return {"ok": False, "error": "no monitor", "workspace": ws}
    metrics = layout_metrics(mon)
    if (use_scrolling or layout == "master") and len(locked_geoms) < 2:
        return {"ok": True, "workspace": ws, "closeEnough": True, "mode": layout, "windows": []}
    if workspace_is_scrolling(ws, workspaces) and layout == "dwindle":
        force_dwindle(ws)
        time.sleep(0.05)
        cache_clear()
        workspaces = hypr_j("workspaces", cached=True)
    clients = clients_on_workspace(ws)
    used: set[str] = set()
    items: list[dict[str, Any]] = []
    for i, a in enumerate(locked):
        hit = match_client(a, clients, used)
        if not hit:
            continue
        used.add(hit["address"])
        g = a.get("geom")
        if not g:
            box = actual_box(hit["address"])
            g = box_to_geom(box, metrics) if box else fallback_geom(i, n_lock)
        items.append({
            "addr": hit["address"],
            "geom": g,
            "px": tile_px(hit["address"], g, metrics),
            "name": a.get("name"),
            "lock": True,
        })
    if not items:
        return {"ok": True, "skipped": True, "workspace": ws, "reason": "no clients"}
    for it in items:
        clear_size_lock(it["addr"])
    last = apply_tiled_split(items, metrics)
    locked_placed = [it for it in last if it.get("lock")]
    ok = bool(locked_placed) and all(close_enough(it.get("place"), it.get("px"), tol=32) for it in locked_placed)
    return {
        "ok": True,
        "workspace": ws,
        "closeEnough": ok,
        "mode": "dwindle",
        "windows": [{"addr": it.get("addr"), "actual": it.get("place"), "requested": it.get("px"), "lock": it.get("lock") is True} for it in last],
    }


def apply_one(addr: str, geom_json: str, ws: str) -> dict[str, Any]:
    geom = json.loads(geom_json)
    cache_clear()
    monitors = hypr_j("monitors", cached=True)
    workspaces = hypr_j("workspaces", cached=True)
    mon = monitor_for_workspace(ws, monitors, workspaces)
    if not mon:
        return {"ok": False, "error": "no monitor"}
    metrics = layout_metrics(mon)
    px = geom_pixels(geom, metrics)
    items = apply_items([{"addr": addr, "geom": geom, "px": px}], metrics, ws)
    box = actual_box(addr)
    return {"ok": True, "metrics": metrics, "requested": px, "actual": box, "placed": items[0]["place"] if items else px}


def exec_app_id(exec_cmd: str) -> str:
    """Hyprland class for `foot --app-id=foo` stays `foo` even after the title changes."""
    parts = str(exec_cmd or "").split()
    for i, tok in enumerate(parts):
        if tok.startswith("--app-id="):
            return tok.split("=", 1)[1].strip().lower()
        if tok in ("--app-id", "-a") and i + 1 < len(parts):
            return parts[i + 1].strip().lower()
    return ""


def match_client(assignment: dict[str, Any], clients: list[dict[str, Any]], used: set[str]) -> dict[str, Any] | None:
    exec_cmd = str(assignment.get("exec") or assignment.get("command") or "")
    base = exec_cmd.split()[0].split("/")[-1].lower() if exec_cmd else ""
    name = str(assignment.get("name") or "").lower()
    app_id = exec_app_id(exec_cmd)
    want_cls = str(assignment.get("class") or assignment.get("windowClass") or "").lower()
    want_title = str(assignment.get("title") or "").lower()
    best = None
    best_score = 0
    for c in clients:
        addr = c.get("address")
        if not addr or addr in used:
            continue
        cls = str(c.get("class") or "").lower()
        title = str(c.get("title") or "").lower()
        initial = str(c.get("initialClass") or "").lower()
        initial_title = str(c.get("initialTitle") or "").lower()
        score = 0
        if want_cls and (want_cls == cls or want_cls == initial or want_cls in cls or cls in want_cls):
            score += 16
        if want_title and (want_title == title or want_title in title or want_title in initial_title):
            score += 10
        if app_id and (app_id == cls or app_id == initial or app_id in cls):
            score += 14
        if "herdr" in exec_cmd.lower() and "herdr" in cls:
            score += 12
        shophawk_slot = "shophawk-panel" in exec_cmd.lower() or (
            "shophawk" in name and "herdr" not in name and "herdr" not in exec_cmd.lower()
        )
        if shophawk_slot and "herdr" not in cls:
            if "shophawk" in title:
                score += 12
            if "quickshell" in cls:
                score += 10
        host = ""
        if "https://" in exec_cmd:
            try:
                host = exec_cmd.split("https://", 1)[1].split("/")[0].lower().removeprefix("www.")
            except Exception:
                host = ""
        site_app = bool(
            cls.startswith("brave-") and "." in cls
            or cls.startswith("chrome-") and "." in cls
            or cls.startswith("chromium-") and "." in cls
        )
        if host:
            if host in cls or host in title:
                score += 16
        elif base in {"brave", "brave-browser", "chromium", "google-chrome", "chrome"}:
            if cls in {"brave-browser", "brave", "chromium", "google-chrome", "chromium-browser"} and not site_app:
                score += 10
        elif base and base not in {"uwsm-app", "omarchy-launch-tui", "omarchy-launch-or-focus-tui", "sh", "bash"}:
            if base == cls or base in cls or base in initial:
                score += 6
        if name and not (base in {"brave", "chromium"} and site_app):
            if name in title or name in initial_title or name in cls:
                score += 4
        at = c.get("at") or [0, 0]
        size = c.get("size") or [0, 0]
        x = int(at[0] or 0)
        w = int(size[0] or 0)
        if score > best_score:
            best_score = score
            best = c
            continue
        if score == best_score and best is not None:
            bat = best.get("at") or [0, 0]
            bsz = best.get("size") or [0, 0]
            bx, bw = int(bat[0] or 0), int(bsz[0] or 0)
            # Same site-app class (Outlook extras): keep the existing full pane,
            # not the extra the user is closing.
            if w > bw + 8 or (abs(w - bw) <= 8 and x < bx):
                best = c
    return best if best_score > 0 else None


def remap_profile_workspace(profile: dict[str, Any], src: str, dest: str) -> dict[str, Any]:
    """Copy source workspace assignments/prefs onto dest. No monitor pins."""
    src_s = SAFE.safe_ws(src)
    dest_s = SAFE.safe_ws(dest)
    if not src_s or not dest_s:
        return profile
    out = json.loads(json.dumps(profile))
    mapped: list[dict[str, Any]] = []
    for a in out.get("assignments") or []:
        if not isinstance(a, dict) or a.get("enabled") is False:
            continue
        if str(a.get("workspace") or "") != src_s:
            continue
        item = dict(a)
        try:
            item["workspace"] = int(dest_s)
        except ValueError:
            item["workspace"] = dest_s
        mapped.append(item)
    out["assignments"] = mapped
    prefs = out.get("workspacePrefs") if isinstance(out.get("workspacePrefs"), dict) else {}
    if src_s in prefs:
        prefs[dest_s] = json.loads(json.dumps(prefs[src_s]))
    out["workspacePrefs"] = prefs
    out["workspaceMonitors"] = {}
    return out


def apply_config(config_path: str, profile_id: str = "", remap: str = "") -> dict[str, Any]:
    cfg = load_config(config_path)
    profile = active_profile(cfg, profile_id)
    if not profile:
        return {"ok": False, "error": "no profile"}
    if remap and ":" in remap:
        src, dest = remap.split(":", 1)
        profile = remap_profile_workspace(profile, src, dest)
        profiles = cfg.get("profiles") if isinstance(cfg.get("profiles"), list) else []
        for i, p in enumerate(profiles):
            if isinstance(p, dict) and p.get("id") == profile.get("id"):
                profiles[i] = profile
                break
        cfg["profiles"] = profiles
    cache_clear()
    clients = hypr_j("clients")
    prefs = profile.get("workspacePrefs") or {}
    by_ws: dict[str, list[dict[str, Any]]] = {}
    used: set[str] = set()
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        locked = assignment_is_locked(a, prefs)
        geom = a.get("geom")
        if not geom and not locked:
            continue
        ws = str(a.get("workspace") or "1")
        if occupied_skip(ws, profile):
            continue
        on_ws = [
            c for c in clients
            if str((c.get("workspace") or {}).get("id")) == ws or str((c.get("workspace") or {}).get("name")) == ws
        ]
        hit = match_client(a, on_ws, used)
        if not hit:
            continue
        used.add(hit["address"])
        by_ws.setdefault(ws, []).append({
            "addr": hit["address"],
            "geom": geom,
            "name": a.get("name"),
            "lock": locked,
            "place": "float" if a.get("place") == "float" else "tile",
            "chrome": a.get("chrome") if isinstance(a.get("chrome"), dict) else None,
        })
    results = []
    prev_focus = active_window_addr()
    for ws, windows in sorted(by_ws.items(), key=lambda kv: int(kv[0]) if str(kv[0]).isdigit() else 99):
        cache_clear()
        monitors = hypr_j("monitors", cached=True)
        workspaces = hypr_j("workspaces", cached=True)
        mon = monitor_for_workspace(ws, monitors, workspaces)
        if mon:
            metrics = layout_metrics(mon)
            for i, win in enumerate(windows):
                if win.get("geom"):
                    continue
                box = actual_box(win["addr"])
                win["geom"] = box_to_geom(box, metrics) if box else fallback_geom(i, len(windows))
        floats = [w for w in windows if w.get("place") == "float"]
        result = restore_locks_for_workspace(str(ws), cfg, profile_id, keep_focus=True)
        metrics = layout_metrics(mon) if mon else {"x": 0, "y": 0, "w": 1, "h": 1}
        floats_sorted = sorted(
            floats,
            key=lambda w: int((w.get("geom") or {}).get("z") or 0),
        )
        for win in floats_sorted:
            if not win.get("geom"):
                continue
            px = geom_pixels(win["geom"], metrics)
            apply_abs_box(win["addr"], px)
            raise_window(win["addr"])
            if win.get("chrome"):
                apply_chrome(win["addr"], win["chrome"], True)
        for win in floats_sorted:
            raise_window(win["addr"])
        for win in windows:
            if win.get("chrome"):
                apply_chrome(win["addr"], win["chrome"], False)
        results.append(result)
    seen = {str(ws) for ws, _ in by_ws.items()}
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        ws = str(a.get("workspace") or "")
        if not ws or ws in seen:
            continue
        seen.add(ws)
        results.append(restamp_layout_sizes(ws, profile))
    if prev_focus:
        focus_window(prev_focus)
    return {"ok": True, "workspaces": results}


def apply_many(payload: dict[str, Any]) -> dict[str, Any]:
    ws = str(payload.get("workspace") or "1")
    cache_clear()
    monitors = hypr_j("monitors", cached=True)
    workspaces = hypr_j("workspaces", cached=True)
    mon = monitor_for_workspace(ws, monitors, workspaces)
    if not mon:
        return {"ok": False, "error": "no monitor"}
    metrics = layout_metrics(mon)
    items = []
    for it in payload.get("windows") or []:
        addr = it.get("addr")
        geom = it.get("geom") or {}
        if not addr or not geom:
            continue
        items.append({"addr": addr, "geom": geom, "px": geom_pixels(geom, metrics), "lock": it.get("lock") is True})
    vis = clamp_visible_count(payload.get("visibleCount"))
    if workspace_is_scrolling(ws, workspaces) or payload.get("scrolling") is True:
        placed = place_scrolling_columns(items, metrics, ws, extra_column_frac(vis))
    else:
        placed = apply_items(items, metrics, ws)
    cache_clear()
    actual = []
    for it in placed:
        box = actual_box(it["addr"])
        actual.append({"addr": it["addr"], "place": it["place"], "actual": box})
    return {"ok": True, "metrics": metrics, "windows": actual}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply-one", action="store_true")
    parser.add_argument("--apply-many", action="store_true")
    parser.add_argument("--apply-config", action="store_true")
    parser.add_argument("--restore-locks", action="store_true")
    parser.add_argument("--config", default="")
    parser.add_argument("--profile-id", default="")
    parser.add_argument("--addr", default="")
    parser.add_argument("--geom", default="")
    parser.add_argument("--payload", default="")
    parser.add_argument("--workspace", default="1")
    parser.add_argument("--metrics", action="store_true")
    parser.add_argument("--clear-size-locks", action="store_true")
    parser.add_argument("--exec-silent", default="")
    parser.add_argument("--monitor", default="")
    parser.add_argument("--remap", default="")
    args = parser.parse_args()
    if args.clear_size_locks:
        n = clear_all_size_locks()
        print(json.dumps({"ok": True, "cleared": n}))
        return 0
    if args.exec_silent:
        lua = exec_silent(args.exec_silent, args.workspace, args.monitor)
        print(lua)
        return 0
    if args.metrics:
        monitors = hypr_j("monitors")
        workspaces = hypr_j("workspaces")
        mon = monitor_for_workspace(args.workspace, monitors, workspaces)
        print(json.dumps(layout_metrics(mon) if mon else {}))
        return 0
    if args.restore_locks:
        cfg = load_config(args.config) if args.config else None
        result = restore_locks_for_workspace(args.workspace, cfg, args.profile_id, prefer_addr=args.addr)
        print(json.dumps(result))
        return 0 if result.get("ok") else 1
    if args.apply_config:
        result = apply_config(args.config, args.profile_id, remap=args.remap)
        print(json.dumps(result))
        return 0 if result.get("ok") else 1
    if args.apply_many:
        payload = json.loads(args.payload or sys.stdin.read())
        result = apply_many(payload)
        print(json.dumps(result))
        return 0 if result.get("ok") else 1
    if args.apply_one:
        result = apply_one(args.addr, args.geom, args.workspace)
        print(json.dumps(result))
        return 0 if result.get("ok") else 1
    parser.error("nothing to do")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
