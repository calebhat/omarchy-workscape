#!/usr/bin/env python3
"""Write and apply WorkScape trackpad / workspace-swipe prefs."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

SAFE = SourceFileLoader("workscape_hyprsafe", str(Path(__file__).resolve().parent / "hyprsafe")).load_module()


def default_gestures() -> dict:
    return {
        "workspaceSwipe": True,
        "fingers": 3,
        "skipEmpty": True,
        "invert": True,
        "createNew": False,
        "forever": False,
        "touch": False,
        "keyboard": False,
        "scratchpadSwipe": False,
        "scratchpadFingers": 4,
    }


def clamp_int(v, lo, hi, fallback):
    try:
        n = int(v)
    except Exception:
        return fallback
    return min(hi, max(lo, n))


def normalize_gestures(raw: dict | None) -> dict:
    src = raw if isinstance(raw, dict) else {}
    out = default_gestures()
    out["workspaceSwipe"] = src.get("workspaceSwipe") is not False
    out["fingers"] = 4 if int(src.get("fingers") or 3) == 4 else 3
    out["skipEmpty"] = src.get("skipEmpty") is not False
    out["invert"] = src.get("invert") is not False
    out["createNew"] = src.get("createNew") is True
    out["forever"] = src.get("forever") is True
    out["touch"] = src.get("touch") is True
    out["keyboard"] = src.get("keyboard") is True
    out["scratchpadSwipe"] = src.get("scratchpadSwipe") is True
    out["scratchpadFingers"] = 4 if int(src.get("scratchpadFingers") or 4) != 3 else 3
    return out


def resolve_gestures(cfg: dict, profile_id: str = "") -> dict:
    settings = cfg.get("settings") or {}
    source = settings.get("gestureSource")
    g = normalize_gestures(settings.get("gestures"))
    if source != "profile":
        return g
    profiles = cfg.get("profiles") or []
    pid = profile_id or (settings.get("activeProfileId") or "")
    profile = next((p for p in profiles if p.get("id") == pid), None)
    if not profile:
        profile = profiles[0] if profiles else {}
    pg = profile.get("gestures") if isinstance(profile.get("gestures"), dict) else None
    if pg:
        return normalize_gestures(pg)
    return g


def lua_bool(v: bool) -> str:
    return "true" if v else "false"


def render_lua(g: dict) -> str:
    g = normalize_gestures(g)
    fingers = g["fingers"]
    skip = g["skipEmpty"]
    use_r = not skip
    lines = [
        "-- Generated by WorkScape. Do not edit.",
        "hl.config({",
        "  gestures = {",
        f"    workspace_swipe_use_r = {lua_bool(use_r)},",
        f"    workspace_swipe_create_new = {lua_bool(g['createNew'])},",
        f"    workspace_swipe_forever = {lua_bool(g['forever'])},",
        f"    workspace_swipe_invert = {lua_bool(g['invert'])},",
        f"    workspace_swipe_touch = {lua_bool(g['touch'])},",
        "  },",
        "})",
        "",
    ]
    if g["workspaceSwipe"]:
        lines.append(
            f'hl.gesture({{ fingers = {fingers}, direction = "horizontal", action = "workspace" }})'
        )
        lines.append(f"WORKSCAPE_SWIPE_FINGERS = {fingers}")
        lines.append("")
    else:
        lines.append("WORKSCAPE_SWIPE_FINGERS = 0")
        lines.append("")
    if g["scratchpadSwipe"]:
        sf = g["scratchpadFingers"]
        lines.append(
            f'hl.gesture({{ fingers = {sf}, direction = "down", action = "special", workspace_name = "scratchpad" }})'
        )
        lines.append("")
    lines.extend(
        [
            'pcall(function() hl.unbind("SUPER + comma") end)',
            'pcall(function() hl.unbind("SUPER + period") end)',
            "",
        ]
    )
    if g["keyboard"]:
        sel = "e" if skip else "r"
        lines.extend(
            [
                f'o.bind("SUPER + comma", "Previous workspace", hl.dsp.focus({{ workspace = "{sel}-1" }}))',
                f'o.bind("SUPER + period", "Next workspace", hl.dsp.focus({{ workspace = "{sel}+1" }}))',
                "",
            ]
        )
    return "\n".join(lines)


def config_lua_eval(g: dict) -> str:
    g = normalize_gestures(g)
    use_r = not g["skipEmpty"]
    return (
        "hl.config({ gestures = { "
        f"workspace_swipe_use_r = {lua_bool(use_r)}, "
        f"workspace_swipe_create_new = {lua_bool(g['createNew'])}, "
        f"workspace_swipe_forever = {lua_bool(g['forever'])}, "
        f"workspace_swipe_invert = {lua_bool(g['invert'])}, "
        f"workspace_swipe_touch = {lua_bool(g['touch'])} "
        "} })"
    )


def hypr_eval(lua: str) -> None:
    SAFE.bounded_run(["hyprctl", "eval", lua], timeout=3.0)


def last_fingers_path() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "omarchy/workscape/last-swipe-fingers"


def keyboard_claim_path() -> Path:
    """Marks that we took SUPER+,/. off whatever had them.

    SUPER+comma is Omarchy's dismiss-notification bind, so the keys are only
    released when we are the ones holding them — never on behalf of a user who
    has this switched off.
    """
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "omarchy/workscape/keyboard-binds-claimed"


REQUIRE_LINE = 'pcall(require, "hypr.workscape-gestures")'
REQUIRE_MARK = "-- WorkScape trackpad workspace swipe (generated file)."
HOTKEYS_LINE = 'pcall(require, "hypr.workscape-hotkeys")'
HOTKEYS_MARK = "-- WorkScape hotkeys (generated file)."
OWNED_GESTURES = "-- Generated by WorkScape. Do not edit."
OWNED_BINDS = "-- WorkScape bind overlay."
OWNED_STATE = "hypr-owned.json"
REQUIRE_BLOCKS = (
    (REQUIRE_MARK, REQUIRE_LINE),
    (HOTKEYS_MARK, HOTKEYS_LINE),
)


def ensure_hyprland_require(hypr_dir: Path, mark: str = "", line: str = "") -> bool:
    """Load a generated WorkScape lua file on compositor start / reload."""
    mark = mark or REQUIRE_MARK
    line = line or REQUIRE_LINE
    lua = Path(hypr_dir) / "hyprland.lua"
    try:
        text = SAFE.read_nofollow(lua, 1024 * 1024).decode("utf-8")
    except OSError:
        return False
    if "hypr.workscape-gestures" in line and "hypr.workscape-gestures" in text:
        return False
    if "hypr.workscape-hotkeys" in line and "hypr.workscape-hotkeys" in text:
        return False
    if line.strip() in text:
        return False
    snippet = (
        f"\n{mark}\n"
        f"{line}\n"
    )
    SAFE.write_atomic(lua, text.rstrip() + snippet + "\n", mode=0o644, backup=True, max_bytes=2 * 1024 * 1024)
    _owned_set(hyprland_inserted=True)
    return True


def strip_require_pair(text: str, mark: str, line: str) -> str:
    lines = text.splitlines(True)
    out = []
    i = 0
    mark_s = mark.strip()
    line_s = line.strip()
    while i < len(lines):
        cur = lines[i].rstrip("\r\n")
        nxt = lines[i + 1].rstrip("\r\n") if i + 1 < len(lines) else ""
        if cur.strip() == mark_s and nxt.strip() == line_s:
            i += 2
            if i < len(lines) and lines[i].strip() == "":
                i += 1
            continue
        out.append(lines[i])
        i += 1
    return "".join(out)


def strip_owned_require_block(text: str) -> str:
    for mark, line in REQUIRE_BLOCKS:
        text = strip_require_pair(text, mark, line)
    return text


def strip_hyprland_require(hypr_dir: Path, mark: str, line: str) -> bool:
    lua = Path(hypr_dir) / "hyprland.lua"
    try:
        text = SAFE.read_nofollow(lua, 2 * 1024 * 1024).decode("utf-8")
    except OSError:
        return False
    new = strip_require_pair(text, mark, line)
    if new == text:
        return False
    SAFE.write_atomic(lua, new if new.endswith("\n") else new + "\n", mode=0o644, backup=False)
    return True


def _owned_load() -> dict:
    try:
        dirfd = SAFE.open_state_dir(create=True)
        try:
            raw = SAFE.read_at(dirfd, OWNED_STATE, 8192)
        finally:
            os.close(dirfd)
        doc = json.loads(raw.decode("utf-8"))
        if not isinstance(doc, dict):
            return {"hyprlandInserted": False, "files": {}}
        files = doc.get("files") if isinstance(doc.get("files"), dict) else {}
        return {"hyprlandInserted": doc.get("hyprlandInserted") is True, "files": files}
    except Exception:
        return {"hyprlandInserted": False, "files": {}}


def owned_get() -> dict:
    return _owned_load()


def owned_put(doc: dict) -> None:
    _owned_save(doc)


def _owned_save(doc: dict) -> None:
    dirfd = SAFE.open_state_dir(create=True)
    try:
        payload = json.dumps(doc).encode("utf-8")
        SAFE.write_at(dirfd, OWNED_STATE, payload, mode=0o600, max_bytes=8192)
    finally:
        os.close(dirfd)


def _owned_set(hyprland_inserted: bool | None = None, file_name: str = "", digest: str = "") -> None:
    doc = _owned_load()
    if hyprland_inserted is not None:
        doc["hyprlandInserted"] = hyprland_inserted
    if file_name and digest:
        files = doc.setdefault("files", {})
        files[file_name] = digest
    _owned_save(doc)


def record_owned_bytes(name: str, data: bytes) -> None:
    _owned_set(file_name=name, digest=hashlib.sha256(data).hexdigest())


def record_owned_from_disk(hypr: Path, name: str) -> dict:
    data = SAFE.read_nofollow(hypr / name, SAFE.MAX_CONFIG_BYTES)
    record_owned_bytes(name, data)
    return {"ok": True, "name": name, "digest": hashlib.sha256(data).hexdigest()}


def restore_hypr_persist(hypr_dir: str = "") -> dict:
    home = Path.home()
    hypr = Path(hypr_dir) if hypr_dir else home / ".config" / "hypr"
    lua = hypr / "hyprland.lua"
    bak = hypr / "hyprland.lua.workscape.bak"
    owned = _owned_load()
    errors: list[str] = []
    files_out: dict[str, str] = {}
    hyprland_status = "unchanged"
    backup_status = "absent"
    try:
        SAFE.read_nofollow(bak, 2 * 1024 * 1024)
        backup_status = "kept"
    except OSError:
        backup_status = "absent"
    try:
        text = SAFE.read_nofollow(lua, 2 * 1024 * 1024).decode("utf-8")
    except FileNotFoundError:
        if backup_status == "kept":
            try:
                bak_data = SAFE.read_nofollow(bak, 2 * 1024 * 1024)
                SAFE.write_atomic(lua, bak_data, mode=0o644, backup=False, max_bytes=2 * 1024 * 1024)
                hyprland_status = "restored-interrupted"
                backup_status = "used-interrupted"
            except OSError as e:
                hyprland_status = f"error:{e}"
                errors.append(f"hyprland.lua: {e}")
        else:
            hyprland_status = "absent"
    except OSError as e:
        hyprland_status = f"error:{e}"
        errors.append(f"hyprland.lua: {e}")
    else:
        if owned.get("hyprlandInserted"):
            new = strip_owned_require_block(text)
            if new != text:
                try:
                    SAFE.write_atomic(
                        lua,
                        new if new.endswith("\n") else new + "\n",
                        mode=0o644,
                        backup=False,
                    )
                    hyprland_status = "stripped"
                    _owned_set(hyprland_inserted=False)
                except OSError as e:
                    hyprland_status = f"error:{e}"
                    errors.append(f"hyprland.lua: {e}")
            else:
                hyprland_status = "unchanged"
        else:
            hyprland_status = "skipped"
    for name, digest in (owned.get("files") or {}).items():
        path = hypr / name
        want = str(digest or "")
        try:
            data = SAFE.read_nofollow(path, SAFE.MAX_CONFIG_BYTES)
        except FileNotFoundError:
            files_out[name] = "absent"
            continue
        except OSError as e:
            files_out[name] = f"error:{e}"
            errors.append(f"{name}: {e}")
            continue
        if hashlib.sha256(data).hexdigest() != want:
            files_out[name] = "conflict"
            errors.append(f"{name}: conflict")
            continue
        try:
            SAFE.unlink_nofollow(path)
            files_out[name] = "removed"
        except OSError as e:
            files_out[name] = f"error:{e}"
            errors.append(f"{name}: {e}")
    ok = not errors and not str(hyprland_status).startswith("error")
    return {
        "ok": ok,
        "hyprland": hyprland_status,
        "files": files_out,
        "backup": backup_status,
        "errors": errors,
        "stripped": hyprland_status in {"stripped", "restored-interrupted"},
        "removed": [n for n, st in files_out.items() if st == "removed"],
    }


def write_and_apply(cfg: dict, profile_id: str = "", hypr_dir: str = "", reload: bool = False) -> dict:
    g = resolve_gestures(cfg, profile_id)
    home = Path.home()
    state = Path(os.environ.get("XDG_STATE_HOME") or str(home / ".local/state")) / "omarchy/workscape"
    lua = render_lua(g)
    dest = state / "workscape-gestures.lua"
    SAFE.write_atomic(dest, lua, mode=0o600)
    persist = ((cfg.get("settings") or {}).get("persistHyprGestures") is True)
    hypr_dest = Path(hypr_dir) if hypr_dir else home / ".config/hypr/workscape-gestures.lua"
    if persist:
        payload = lua.encode("utf-8")
        SAFE.write_atomic(hypr_dest, payload, mode=0o644)
        dest = hypr_dest
        record_owned_bytes(hypr_dest.name, payload)
        ensure_hyprland_require(hypr_dest.parent)
    hypr_eval(config_lua_eval(g))
    # Register the workspace keybinds live, the way the swipe gesture below is.
    # The generated file only reaches Hyprland when the user opts into
    # persisting it, so binding through the file alone left SUPER+,/. on
    # whatever they were bound to in the default configuration.
    claim = keyboard_claim_path()
    claimed = claim.exists()
    if g["keyboard"]:
        sel = "e" if g["skipEmpty"] else "r"
        hypr_eval('pcall(function() hl.unbind("SUPER + comma") end)')
        hypr_eval('pcall(function() hl.unbind("SUPER + period") end)')
        hypr_eval(
            f'o.bind("SUPER + comma", "Previous workspace", hl.dsp.focus({{ workspace = "{sel}-1" }}))'
        )
        hypr_eval(
            f'o.bind("SUPER + period", "Next workspace", hl.dsp.focus({{ workspace = "{sel}+1" }}))'
        )
        SAFE.write_atomic(claim, "1", mode=0o600)
    elif claimed:
        # Hand the keys back. Hyprland cannot restore what held them before, so
        # they stay free until the next reload rereads the user's config.
        hypr_eval('pcall(function() hl.unbind("SUPER + comma") end)')
        hypr_eval('pcall(function() hl.unbind("SUPER + period") end)')
        try:
            SAFE.unlink_nofollow(claim)
        except Exception:
            pass
    prev = 0
    stamp = last_fingers_path()
    try:
        prev = int(SAFE.read_nofollow(stamp, 32).decode("ascii", "replace").strip() or "0")
    except Exception:
        prev = 0
    # Hyprland lets one HORIZONTAL workspace gesture shadow another. Always
    # drop 3- and 4-finger swipes first, then register only the chosen one.
    hypr_eval('hl.gesture({ fingers = 3, direction = "horizontal", action = "unset" })')
    hypr_eval('hl.gesture({ fingers = 4, direction = "horizontal", action = "unset" })')
    if g["workspaceSwipe"]:
        hypr_eval(
            f'hl.gesture({{ fingers = {g["fingers"]}, direction = "horizontal", action = "workspace" }})'
        )
        SAFE.write_atomic(stamp, str(g["fingers"]), mode=0o600)
    else:
        try:
            SAFE.unlink_nofollow(stamp)
        except Exception:
            pass
    # Keybinds are applied above without a reload; a full reload remounts the
    # panel and makes the Gestures options vanish, so it is left to the caller.
    if reload:
        SAFE.bounded_run(["hyprctl", "reload"], timeout=8.0)
    return {"ok": True, "path": str(dest), "gestures": g}


def persist_workspaces(enable: bool) -> None:
    flag = "true" if enable else "false"
    occupied = {s for s in os.environ.get("WORKSCAPE_OCCUPIED_WS", "").split() if s}
    for ws in range(1, 11):
        if str(ws) in occupied:
            continue
        hypr_eval(f'hl.workspace_rule({{ workspace = "{ws}", persistent = {flag} }})')


def safe_label(name: str) -> str:
    out = []
    for ch in str(name or "").strip()[:24]:
        if ch.isalnum() or ch in " _-":
            out.append(ch)
    return "".join(out).strip()


def apply_names(names: dict) -> None:
    for ws, name in (names or {}).items():
        label = safe_label(name)
        if not label or not str(ws).isdigit():
            continue
        hypr_eval(f'hl.workspace_rule({{ workspace = "{ws}", persistent = true }})')
        hypr_eval(
            f'hl.dispatch(hl.dsp.workspace.rename({{ workspace = "{ws}", name = "{label}" }}))'
        )


def focus_default(ws: int) -> None:
    if 1 <= int(ws) <= 10:
        hypr_eval(f'hl.dispatch(hl.dsp.focus({{ workspace = "{int(ws)}" }}))')


def apply_profile_extras(profile: dict) -> None:
    if profile.get("persistentWorkspaces") is True:
        persist_workspaces(True)
    names = profile.get("workspaceNames") if isinstance(profile.get("workspaceNames"), dict) else {}
    apply_names(names)
    dw = int(profile.get("defaultWorkspace") or 0)
    if dw >= 1:
        focus_default(dw)


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--config", default="")
    p.add_argument("--profile-id", default="")
    p.add_argument("--apply", action="store_true")
    p.add_argument("--extras", action="store_true")
    p.add_argument("--render", action="store_true")
    p.add_argument("--restore-hypr", action="store_true")
    p.add_argument("--record-owned", default="")
    p.add_argument("--hypr-dir", default="")
    args = p.parse_args()
    if args.restore_hypr:
        print(json.dumps(restore_hypr_persist(args.hypr_dir)))
        return 0
    if args.record_owned:
        hypr = Path(args.hypr_dir) if args.hypr_dir else Path.home() / ".config" / "hypr"
        print(json.dumps(record_owned_from_disk(hypr, args.record_owned)))
        return 0
    if not args.config:
        print("--config required", file=sys.stderr)
        return 2
    cfg = SAFE.load_json_file(Path(args.config))
    if args.render:
        print(render_lua(resolve_gestures(cfg, args.profile_id)))
        return 0
    result = write_and_apply(cfg, args.profile_id, reload=False)
    if args.extras:
        profile = None
        pid = args.profile_id or ((cfg.get("settings") or {}).get("activeProfileId") or "")
        for pr in cfg.get("profiles") or []:
            if pr.get("id") == pid:
                profile = pr
                break
        if profile:
            apply_profile_extras(profile)
    print(json.dumps(result))
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
