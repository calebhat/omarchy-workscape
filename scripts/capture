#!/usr/bin/env python3
"""Snapshot live Hyprland windows on a workspace into WorkScape assignments."""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

GEOM = SourceFileLoader("workscape_geom_capture", str(Path(__file__).resolve().parent / "geom")).load_module()


def hypr_j(cmd: str):
    data = GEOM.SAFE.hypr_json(cmd.split())
    if isinstance(data, list) and len(data) > 40:
        return data[:40]
    return data


_CWD_OK = re.compile(r"^/[A-Za-z0-9._/+\- ]{0,399}$")
_URL_OK = re.compile(r"^https://[A-Za-z0-9][A-Za-z0-9._~:/?#@&=+%,\-]*$")
_WS_OK = re.compile(r"^(?:[1-9]|1[0-9]|20)$")


def safe_cwd(path: str) -> str:
    p = str(path or "").strip()
    if not p or ".." in p or not _CWD_OK.fullmatch(p):
        return ""
    if not os.path.isdir(p):
        return ""
    return p


def safe_url(url: str) -> str:
    u = str(url or "").strip()[:300]
    if not _URL_OK.fullmatch(u):
        return ""
    return u


def children(pid: int) -> list[int]:
    try:
        raw = Path(f"/proc/{int(pid)}/task/{int(pid)}/children").read_bytes()[:256].decode("ascii", "replace").split()
        out = []
        for x in raw[:32]:
            out.append(int(x))
        return out
    except Exception:
        return []


def proc_cwd(pid: int) -> str:
    try:
        return os.readlink(f"/proc/{int(pid)}/cwd")[:400]
    except Exception:
        return ""


def proc_cmd(pid: int) -> str:
    try:
        raw = Path(f"/proc/{int(pid)}/cmdline").read_bytes()[:4096]
        return raw.replace(b"\x00", b" ").decode("utf-8", "replace").strip()
    except Exception:
        return ""


def shell_cwd(pid: int) -> str:
    """Prefer a shell child's cwd over the terminal process (often /)."""
    shells = {"bash", "zsh", "fish", "sh", "nu"}
    best = proc_cwd(pid)
    stack = children(pid)
    seen = set()
    visits = 0
    while stack:
        c = stack.pop()
        if c in seen:
            continue
        seen.add(c)
        visits += 1
        if visits > 32:
            break
        cmd = proc_cmd(c)
        base = cmd.split()[0].split("/")[-1] if cmd else ""
        cwd = proc_cwd(c)
        if base in shells and cwd and cwd not in {"/", "/home", str(Path.home())}:
            return cwd
        if base in shells and cwd:
            best = cwd
        stack.extend(children(c))
    return safe_cwd(best) if best not in {"/", ""} else ""


def url_from_client(c: dict) -> str:
    cls = str(c.get("class") or "")
    title = str(c.get("title") or "")
    # Chromium/Brave build an app window's class as
    # "<browser>-<host>__<path>-<profile-dir>", where the profile directory is
    # "Default" for the default profile and "Profile_N" otherwise. Stripping only
    # the exact "_-Default" left the suffix in place for every other case, so a
    # non-default profile turned into a bogus path segment ("/-Profile/1") that
    # then compounded on each re-capture, and "<path>-Default" kept the
    # "-Default". Strip either suffix, then drop the separator left behind when
    # the path was empty.
    m = re.match(
        r"^(?:brave|chrome|chromium|google-chrome)-(.+?)(?:_?-Default|_?-Profile_\d+)?$",
        cls,
    )
    if m and "." in m.group(1):
        rest = m.group(1).rstrip("_")
        host, _, path = rest.partition("__")
        path = path.replace("_", "/")
        if host and "/" not in host:
            url = "https://" + host
            if path:
                url += "/" + path.lstrip("/")
            return safe_url(url.rstrip("/"))
    cmd = proc_cmd(int(c.get("pid") or 0)) if c.get("pid") else ""
    um = re.search(r"https://[^\s\"']+", cmd)
    if um and "deeplink" not in um.group(0):
        return safe_url(um.group(0))
    if title.startswith("https://"):
        return safe_url(title.split()[0])
    return ""


def _home_bin(name: str) -> str:
    p = Path.home() / ".local" / "bin" / name
    if p.is_file():
        return str(p)
    return name


def exec_for_client(c: dict, url: str, cwd: str) -> str:
    cls = str(c.get("class") or "")
    title = str(c.get("title") or "")
    hay = f"{cls} {title}".lower()
    cmd = proc_cmd(int(c.get("pid") or 0)) if c.get("pid") else ""
    # Herdr runs inside foot with --app-id. The parent cmdline is `foot`, which
    # must not become the launch command or Fresh opens a blank terminal.
    if "herdr" in hay or cls.startswith("org.omarchy.herdr"):
        if "shophawk" in hay or "omarchyhome" in hay:
            return _home_bin("herdr-shophawk")
        return "omarchy-launch-or-focus-tui --app-id=org.omarchy.herdr herdr"
    if cls in {"org.quickshell", "quickshell"} and "shophawk" in hay and "herdr" not in hay:
        return _home_bin("shophawk-panel")
    if cls.startswith("foot") or cls == "foot":
        return "foot"
    if "ghostty" in cls:
        return "ghostty"
    if url:
        return f"omarchy-launch-webapp '{url}'"
    if cls == "brave-browser" or cls == "brave":
        return "brave"
    first = cmd.split()[0] if cmd else ""
    if first.startswith("/") and os.path.isfile(first):
        base = os.path.basename(first)
        if base in {"foot", "foot-client", "ghostty"} and cls not in {"foot", "com.mitchellh.ghostty"}:
            return cls or first
        return first
    return first or cls


def geom_from_client(c: dict, mon: dict, grow_top: int = 0) -> dict | None:
    if not mon:
        return None
    at = c.get("at") or [0, 0]
    size = c.get("size") or [0, 0]
    box = {"x": int(at[0]), "y": int(at[1]), "w": int(size[0]), "h": int(size[1])}
    if grow_top:
        # A grouped window sits below its groupbar; the tile starts higher up.
        box["y"] -= grow_top
        box["h"] += grow_top
    if box["w"] <= 0 or box["h"] <= 0:
        return None
    metrics = GEOM.layout_metrics(mon)
    if float(metrics.get("w") or 0) <= 0 or float(metrics.get("h") or 0) <= 0:
        return None
    return GEOM.box_to_geom(box, metrics, min_size=0.04)


def tessellate_tile_geoms(items: list[dict]) -> None:
    """Snap tiled panes to a shared split so captured ratios fill the screen."""
    tiled = [it for it in items if it.get("place") != "float" and isinstance(it.get("geom"), dict)]
    if len(tiled) == 1:
        tiled[0]["geom"] = {"x": 0.0, "y": 0.0, "w": 1.0, "h": 1.0}
        return
    if len(tiled) < 2:
        return
    geoms = [it["geom"] for it in tiled]
    columns = all(float(g.get("y") or 0) < 0.08 and float(g.get("h") or 0) > 0.84 for g in geoms)
    rows = all(float(g.get("x") or 0) < 0.08 and float(g.get("w") or 0) > 0.84 for g in geoms)
    if columns:
        tiled.sort(key=lambda it: float(it["geom"].get("x") or 0))
        splits = [0.0]
        for i in range(len(tiled) - 1):
            left = tiled[i]["geom"]
            right = tiled[i + 1]["geom"]
            edge = (float(left.get("x") or 0) + float(left.get("w") or 0) + float(right.get("x") or 0)) / 2
            splits.append(round(min(0.96, max(0.04, edge)), 4))
        splits.append(1.0)
        for i, it in enumerate(tiled):
            it["geom"] = {"x": splits[i], "y": 0.0, "w": round(splits[i + 1] - splits[i], 4), "h": 1.0}
        return
    if rows:
        tiled.sort(key=lambda it: float(it["geom"].get("y") or 0))
        splits = [0.0]
        for i in range(len(tiled) - 1):
            top = tiled[i]["geom"]
            bot = tiled[i + 1]["geom"]
            edge = (float(top.get("y") or 0) + float(top.get("h") or 0) + float(bot.get("y") or 0)) / 2
            splits.append(round(min(0.96, max(0.04, edge)), 4))
        splits.append(1.0)
        for i, it in enumerate(tiled):
            it["geom"] = {"x": 0.0, "y": splits[i], "w": 1.0, "h": round(splits[i + 1] - splits[i], 4)}


# Single source of truth in scripts/geom: apply needs the same number to
# shrink a grouped window's target box by the groupbar.
groupbar_px = GEOM.groupbar_px


def group_tokens(clients: list[dict]) -> tuple[dict[str, str], dict[str, list[str]]]:
    """Map window address -> group token for every group with two or more members.

    Hyprland reports the whole membership on each member as `grouped`, in tab
    order, so one pass over the clients is enough. A lone window that happens
    to be a one-member group is left ungrouped: persisting it would round-trip
    a groupbar with nothing to switch between.
    """
    by_addr: dict[str, str] = {}
    members: dict[str, list[str]] = {}
    seen: set[frozenset] = set()
    n = 0
    for c in clients:
        grouped = [str(a) for a in (c.get("grouped") or []) if a]
        if len(grouped) < 2:
            continue
        key = frozenset(grouped)
        if key in seen:
            continue
        seen.add(key)
        n += 1
        token = f"g{n}"
        members[token] = grouped
        for a in grouped:
            by_addr[a] = token
    return by_addr, members


def active_group_member(clients: list[dict], addrs: list[str]) -> str:
    """The tab on top: the group member focused most recently.

    Hyprland shows the most recently focused member of a group, and
    focusHistoryID counts up from 0 = most recent. `hidden` is not usable here
    — every member of a group reports hidden=false.
    """
    best, best_id = "", None
    for c in clients:
        a = str(c.get("address") or "")
        if a not in addrs:
            continue
        try:
            fid = int(c.get("focusHistoryID"))
        except (TypeError, ValueError):
            continue
        if best_id is None or fid < best_id:
            best, best_id = a, fid
    return best


def order_group_members(items: list[dict], members: dict[str, list[str]]) -> list[dict]:
    """Keep each group's windows adjacent and in Hyprland's tab order.

    Apply rebuilds a group by adding members one after another, so the stored
    order is what comes back. The group as a whole keeps the position its tile
    had in the sort above.
    """
    if not members:
        return items
    rank = {token: {a: i for i, a in enumerate(addrs)} for token, addrs in members.items()}
    out: list[dict] = []
    emitted: set[str] = set()
    for it in items:
        token = it.get("group")
        if not token:
            out.append(it)
            continue
        if token in emitted:
            continue
        emitted.add(token)
        siblings = [x for x in items if x.get("group") == token]
        siblings.sort(key=lambda x: rank.get(token, {}).get(str(x.get("_addr") or ""), 99))
        out.extend(siblings)
    return out


def collapse_group_tiles(items: list[dict]) -> list[dict]:
    """One proxy per tile: members of a group share the tile they live in.

    Returns proxies carrying the shared geom; write the tessellated result back
    with fan_out_group_tiles().
    """
    proxies: list[dict] = []
    by_token: dict[str, dict] = {}
    for it in items:
        token = it.get("group")
        if it.get("place") == "float" or not token:
            proxies.append({"place": it.get("place"), "geom": it.get("geom"), "members": [it]})
            continue
        head = by_token.get(token)
        if head is None:
            head = {"place": "tile", "geom": it.get("geom"), "members": [it]}
            by_token[token] = head
            proxies.append(head)
        else:
            head["members"].append(it)
    return proxies


def fan_out_group_tiles(proxies: list[dict]) -> None:
    """Copy each tile's geom onto every window sharing that tile."""
    for p in proxies:
        geom = p.get("geom")
        for it in p.get("members") or []:
            if geom:
                it["geom"] = dict(geom)
            elif "geom" in it:
                del it["geom"]


def capture_workspace(ws: str) -> list[dict]:
    clients = hypr_j("clients")
    monitors = list(hypr_j("monitors") or [])
    group_of, group_members = group_tokens(clients)
    bar_px = groupbar_px() if group_of else 0
    group_active = {
        token: active_group_member(clients, addrs)
        for token, addrs in group_members.items()
    }
    out = []
    for c in clients:
        w = c.get("workspace") or {}
        if str(w.get("id")) != str(ws) and str(w.get("name")) != str(ws):
            continue
        cls = str(c.get("class") or "")
        if cls in {"", "org.omarchy.workscape"}:
            continue
        try:
            pid = int(c.get("pid") or 0)
        except Exception:
            pid = 0
        if pid < 2:
            pid = 0
        term = cls in {"foot", "org.wezfurlong.wezterm", "kitty", "Alacritty", "alacritty"} or "ghostty" in cls or cls.startswith("foot")
        cwd = shell_cwd(pid) if pid and term else ""
        url = url_from_client(c)
        mon = GEOM.monitor_for_client(c, monitors) or {}
        item = {
            "workspace": int(ws) if str(ws).isdigit() else ws,
            "name": str(c.get("title") or cls)[:80],
            "class": cls,
            "title": str(c.get("title") or "")[:120],
            "exec": exec_for_client(c, url, cwd),
            "command": exec_for_client(c, url, cwd),
            "type": "webapp" if url else "app",
            "enabled": True,
            "place": "float" if c.get("floating") else "tile",
        }
        cwd = safe_cwd(cwd)
        url = safe_url(url)
        if cwd:
            item["cwd"] = cwd
        if url:
            item["url"] = url
        addr = str(c.get("address") or "")
        token = group_of.get(addr, "")
        if token and item["place"] != "float":
            item["group"] = token
            if group_active.get(token) == addr:
                item["groupActive"] = True
        g = geom_from_client(c, mon, grow_top=bar_px if item.get("group") else 0)
        if g:
            item["geom"] = g
        item["_addr"] = addr
        out.append(item)
    out.sort(key=lambda it: (
        it.get("place") == "float",
        float((it.get("geom") or {}).get("x") or 0),
        float((it.get("geom") or {}).get("y") or 0),
    ))
    out = order_group_members(out, group_members)
    # A group is one tile, so snap tiles with the group collapsed and then give
    # every member the tile's geom. Doing it in this order also cancels the
    # groupbar offset for column and row splits, which tessellation normalises
    # to y=0/h=1 — otherwise each capture would shave the tile again.
    proxies = collapse_group_tiles(out)
    tessellate_tile_geoms(proxies)
    fan_out_group_tiles(proxies)
    tiled_n = sum(1 for p in proxies if p.get("place") != "float")
    if tiled_n >= 2:
        for it in out:
            if it.get("place") != "float":
                it["lockPlace"] = True
    for it in out:
        it.pop("_addr", None)
    return out


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--workspace", required=True)
    args = p.parse_args()
    ws = str(args.workspace)
    if not _WS_OK.fullmatch(ws):
        print("[]")
        return 1
    json.dump(capture_workspace(ws), sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
